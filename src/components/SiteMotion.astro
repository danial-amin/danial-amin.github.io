---
/**
 * Atmosphere + choreography.
 *
 * Renders the four fixed layers (cursor bloom, latent field, grain, scroll
 * progress) and owns every motion listener on the site:
 *   - pointer  -> --mx/--my (drives .bloom / .field) and --prox on [data-prox]
 *   - scroll   -> --progress on the top hairline, plus the reveal sweep
 *   - viewport -> .is-in on [data-reveal] / [data-stagger] / .line-mask
 *
 * All pointer/scroll work is coalesced into a single rAF pass and element
 * positions are cached document-relative, so mousemove and scroll never force
 * a layout read.
 */
---

<div class="bloom" id="bloom" aria-hidden="true"></div>
<div class="field" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<div class="scroll-rule" id="scroll-rule" aria-hidden="true"></div>

<script>
  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- reveal on scroll ---------- */

  const revealTargets = '[data-reveal], [data-stagger], .line-mask, .abyss-note';

  /** observed but not yet revealed — the scroll sweep drains this */
  let pending = [];
  let io = null;

  function reveal(el) {
    el.classList.add('is-in');
    if (io) io.unobserve(el);
  }

  function revealAll() {
    document.querySelectorAll(revealTargets).forEach((el) => el.classList.add('is-in'));
  }

  /**
   * Fallback for the observer. Reveals anything whose top has entered the
   * viewport, regardless of how tall it is.
   *
   * This exists because content whose visibility depends on an animation must
   * never be able to stay hidden. The first version used
   * `threshold: 0.08`, and a ratio threshold is a fraction of the *element's
   * own* area — so an element taller than about 1/threshold viewports can
   * never reach it. The writing index is one ~7000px list of 50 rows; it
   * needed 560px visible and short viewports never delivered that, so it sat
   * at opacity 0 permanently. The threshold is 0 now, and this sweep means
   * even a future mistake degrades to "animation didn't play", not "page is
   * blank".
   */
  function sweepReveals(vh) {
    for (let i = pending.length - 1; i >= 0; i--) {
      const el = pending[i];
      if (el.getBoundingClientRect().top < vh) {
        reveal(el);
        pending.splice(i, 1);
      }
    }
  }

  function observeReveals() {
    if (reduced.matches || !('IntersectionObserver' in window)) {
      revealAll();
      return;
    }

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target);
          const at = pending.indexOf(entry.target);
          if (at > -1) pending.splice(at, 1);
        }
      },
      // threshold MUST stay 0 — see sweepReveals above. The negative bottom
      // margin is what delays the trigger, not a ratio.
      { rootMargin: '0px 0px -10% 0px', threshold: 0 },
    );

    pending = [];

    document.querySelectorAll(revealTargets).forEach((el) => {
      // anything already in view on load reveals immediately, staggered
      if (el.getBoundingClientRect().top < window.innerHeight * 0.92) {
        el.classList.add('is-in');
      } else {
        pending.push(el);
        io.observe(el);
      }
    });
  }

  /* ---------- pointer bloom + proximity ---------- */

  const RANGE = 130; // px falloff for the proximity wash
  let px = -9999;
  let py = -9999;
  let pointerDirty = false;
  let scrollDirty = true;
  let boxes = [];
  let proxEls = [];
  let frame = 0;

  /**
   * Positions are stored document-relative and converted to viewport space with
   * the current scrollY. The writing index has 50 proximity rows, so measuring
   * per scroll frame meant 50 forced layouts a frame; vertical scrolling can't
   * change these values, only a resize or reflow can.
   */
  function measure() {
    proxEls = Array.from(document.querySelectorAll('[data-prox]'));
    const sy = window.scrollY;
    boxes = proxEls.map((el) => {
      const r = el.getBoundingClientRect();
      return { top: r.top + sy, bottom: r.bottom + sy, left: r.left, right: r.right };
    });
  }

  function nearness(box, sy) {
    const dx = Math.max(box.left - px, 0, px - box.right);
    const dy = Math.max(box.top - sy - py, 0, py - (box.bottom - sy));
    const d = Math.hypot(dx, dy);
    return d >= RANGE ? 0 : 1 - d / RANGE;
  }

  const scrollRule = document.getElementById('scroll-rule');
  const bloom = document.getElementById('bloom');

  function tick() {
    frame = 0;

    const sy = window.scrollY;
    const vh = window.innerHeight;

    if (scrollDirty) {
      scrollDirty = false;
      const max = document.documentElement.scrollHeight - vh;
      scrollRule?.style.setProperty('--progress', String(max > 0 ? Math.min(sy / max, 1) : 0));
      if (pending.length) sweepReveals(vh);
    }

    if (pointerDirty) {
      pointerDirty = false;
      root.style.setProperty('--mx', `${px}px`);
      root.style.setProperty('--my', `${py}px`);
    }

    for (let i = 0; i < proxEls.length; i++) {
      const box = boxes[i];
      // skip anything off screen entirely
      if (box.bottom - sy < -RANGE || box.top - sy > vh + RANGE) continue;
      const el = proxEls[i];
      const next = nearness(box, sy);
      const prev = Number(el.dataset.proxValue || 0);
      if (Math.abs(next - prev) < 0.012) continue;
      el.dataset.proxValue = String(next);
      el.style.setProperty('--prox', next.toFixed(3));
    }
  }

  function schedule() {
    if (!frame) frame = requestAnimationFrame(tick);
  }

  function onPointerMove(e) {
    px = e.clientX;
    py = e.clientY;
    pointerDirty = true;
    bloom?.classList.add('is-live');
    schedule();
  }

  function startMotion() {
    measure();
    schedule();

    window.addEventListener(
      'scroll',
      () => {
        scrollDirty = true;
        schedule();
      },
      { passive: true },
    );

    window.addEventListener(
      'resize',
      () => {
        measure();
        scrollDirty = true;
        schedule();
      },
      { passive: true },
    );

    // fonts land after first paint and reflow every row, so re-measure once
    document.fonts?.ready.then(() => {
      measure();
      scrollDirty = true;
      schedule();
    });

    if (reduced.matches) return;

    // coarse pointers (touch) get no bloom and no proximity — it would only
    // ever fire on tap, which reads as a glitch
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      window.addEventListener('pointerleave', () => {
        bloom?.classList.remove('is-live');
        px = -9999;
        py = -9999;
        pointerDirty = true;
        schedule();
      });
    }
  }

  observeReveals();
  startMotion();

  // re-arm after Astro view transitions swap the document
  document.addEventListener('astro:after-swap', () => {
    observeReveals();
    measure();
    scrollDirty = true;
    schedule();
  });
</script>
