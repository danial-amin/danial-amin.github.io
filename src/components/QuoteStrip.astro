---
import testimonials from '../data/testimonials.json';
---

<div class="quote-grid" data-stagger>
  {
    testimonials.map((t, i) => (
      <blockquote class="quote" style={`--i:${i}`}>
        <p>“{t.quote}”</p>
        <footer>
          <strong>{t.name}</strong>
          <br />
          {t.role}, {t.company}
        </footer>
      </blockquote>
    ))
  }
</div>
