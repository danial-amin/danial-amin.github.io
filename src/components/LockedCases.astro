---
/**
 * Gate for the confidential cases.
 *
 * Nothing sensitive is rendered here. No titles, no outcomes, not even a count
 * — the markup is a form and an empty container. The cases live in
 * src/server/locked-cases.json, are read only by /api/unlock, and reach the
 * browser only after the server has checked the passphrase.
 *
 * The previous version server-rendered every locked title and outcome into a
 * `hidden` div and compared a SHA-256 hash that was published in the HTML, so
 * the content was readable with View Source and the hash was brute-forceable
 * offline.
 */
---

<p class="lede" data-set>
  A few engagements stay behind a gate — client-sensitive detail, not marketing copy.
  The passphrase is checked on the server; nothing confidential is in this page until
  it passes.
</p>

<div id="locked-gate" class="gate" data-set>
  <form id="locked-form" >
    <label for="locked-pass">Passphrase</label>
    <div class="gate-row">
      <input
        id="locked-pass"
        name="passphrase"
        type="password"
        autocomplete="current-password"
        required
      />
      <button class="btn" type="submit" id="locked-submit"><span>Unlock</span></button>
    </div>
    <p id="locked-error" class="gate-error" hidden aria-live="polite"></p>
  </form>

  <ul class="listing gate-blur" aria-hidden="true">
    <li>
      <div class="entry">
        <span class="entry-num">··</span>
        <span class="entry-title">Confidential engagement</span>
        <span class="entry-meta">locked</span>
        <p class="entry-blurb">Held on the server until the passphrase is accepted.</p>
      </div>
    </li>
  </ul>
</div>

<div id="locked-content" hidden>
  <ul class="listing" id="locked-list"></ul>
  <p style="margin-top:1.6rem">
    <button class="jump" type="button" id="locked-relock"> ← Lock again
    </button>
  </p>
</div>

<script>
  const gate = document.getElementById('locked-gate');
  const content = document.getElementById('locked-content');
  const list = document.getElementById('locked-list');
  const form = document.getElementById('locked-form') as HTMLFormElement | null;
  const input = document.getElementById('locked-pass') as HTMLInputElement | null;
  const submit = document.getElementById('locked-submit') as HTMLButtonElement | null;
  const error = document.getElementById('locked-error');
  const relock = document.getElementById('locked-relock');

  type Case = { id: string; title: string; outcome: string; year: string; tags?: string[] };

  function fail(message: string) {
    if (!error) return;
    error.textContent = message;
    error.hidden = false;
  }

  function render(cases: Case[]) {
    if (!list || !gate || !content) return;
    list.innerHTML = '';
    cases.forEach((c, i) => {
      const li = document.createElement('li');
      const row = document.createElement('div');
      row.className = 'entry';
      row.setAttribute('data-lift', '');

      const idx = document.createElement('span');
      idx.className = 'entry-num';
      idx.textContent = String(i + 1).padStart(2, '0');

      const title = document.createElement('span');
      title.className = 'entry-title';
      title.textContent = c.title;

      const meta = document.createElement('span');
      meta.className = 'entry-meta';
      meta.textContent = c.year;

      const blurb = document.createElement('p');
      blurb.className = 'entry-blurb';
      blurb.textContent = c.outcome;

      row.append(idx, title, meta, blurb);
      li.append(row);
      list.append(li);
    });

    gate.hidden = true;
    content.hidden = false;
  }

  async function attempt(passphrase: string) {
    if (submit) submit.disabled = true;
    try {
      const res = await fetch('/api/unlock', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ passphrase }),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        if (error) error.hidden = true;
        render(data.cases as Case[]);
        return;
      }
      if (res.status === 429) {
        fail(`Too many attempts. Try again in ${Math.ceil((data.retryInSeconds ?? 900) / 60)} min.`);
      } else if (res.status === 503) {
        fail('The gate is not configured on this server yet.');
      } else {
        fail('That passphrase doesn’t match.');
      }
    } catch {
      fail('Could not reach the server.');
    } finally {
      if (submit) submit.disabled = false;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    attempt(input?.value ?? '');
  });

  relock?.addEventListener('click', async () => {
    await fetch('/api/unlock', { method: 'DELETE' }).catch(() => {});
    if (list) list.innerHTML = '';
    if (content) content.hidden = true;
    if (gate) gate.hidden = false;
    if (input) input.value = '';
  });

  // Restore a still-valid grant so a reload doesn't demand the passphrase again.
  fetch('/api/unlock', { headers: { accept: 'application/json' } })
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      if (d?.ok && Array.isArray(d.cases)) render(d.cases as Case[]);
    })
    .catch(() => {});
</script>
