---
/**
 * Fig. 2 — one block per paper, stacked by the year it landed.
 *
 * Form: 31 papers over four years is small enough to count, so each paper is its
 * own block rather than a summed bar. You can read "21 in 2026" by looking, and
 * the composition by state comes for free in the same mark.
 *
 * The axis is the four years that have output, not a continuous scale — there is
 * nothing between 2021 and 2025 and 70% of the width would have gone to holding
 * that emptiness. The caption says so, because a categorical axis that looks
 * continuous would be the dishonest version of this.
 *
 * Colour carries state, and state is ordered: in review -> accepted -> published.
 *   published  solid, second ink (blue)
 *   accepted   solid, first ink (burgundy)
 *   in review  hollow — no fill at all
 * So identity is never hue alone: the unprinted state is unprinted, which is both
 * the strongest possible secondary encoding and the right metaphor for a press.
 *
 * Palette, measured rather than eyeballed (dataviz validator, OKLab ΔE ×100):
 *   cream stock  #1268b3 / #914e72 — all six checks pass, CVD ΔE 10.6 protan,
 *                normal-vision 18.2, both >= 3:1 on the paper
 *   black stock  #4aa3e0 / #c07d9f — separation passes with room (ΔE 10.5 deutan,
 *                17.6 normal) but the blue sits 0.007 above the lightness band and
 *                the burgundy 0.006 under the chroma floor. Four nudges to fix
 *                the chroma each pushed lightness further out AND dropped protan
 *                separation into the 6-8 warn band, so the site's own dark inks
 *                are the best available pair and the deviation is deliberate.
 */
interface Pub {
  title: string;
  venue: string;
  year: number;
  status: string;
}

interface Props {
  publications: Pub[];
}

const { publications } = Astro.props;

/** "Published, Poster" and "In review, Paper" collapse to their first word(s) */
type State = 'published' | 'accepted' | 'review';
function stateOf(status: string): State {
  const head = status.split(',')[0].trim().toLowerCase();
  if (head === 'accepted') return 'accepted';
  if (head.startsWith('in review')) return 'review';
  return 'published';
}

/** bottom of the stack first — the settled end */
const ORDER: State[] = ['published', 'accepted', 'review'];
const LABEL: Record<State, string> = {
  published: 'Published',
  accepted: 'Accepted',
  review: 'In review',
};

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => a - b);

const columns = years.map((year) => {
  const papers = publications.filter((p) => p.year === year);
  const sorted = ORDER.flatMap((s) => papers.filter((p) => stateOf(p.status) === s));
  return { year, papers: sorted };
});

const tallest = Math.max(...columns.map((c) => c.papers.length));
const totals = ORDER.map((s) => ({
  state: s,
  n: publications.filter((p) => stateOf(p.status) === s).length,
}));

/* ---------- geometry, in user units ---------- */

const COL = 46; // column width
const GAP = 26; // between columns
const BRICK = 9; // one paper
const SPACER = 2; // the surface gap between touching marks
const TOP = 22; // room for the column totals
const BASE = 20; // room for the year labels

const W = columns.length * COL + (columns.length - 1) * GAP;
const plotH = tallest * (BRICK + SPACER);
const H = TOP + plotH + BASE;

const xOf = (i: number) => i * (COL + GAP);
/** stacks upward from the baseline */
const yOf = (n: number) => TOP + plotH - (n + 1) * (BRICK + SPACER) + SPACER;
---

<figure class="pubfig">
  <svg
    class="pubfig-svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`${publications.length} publications by year: ${columns
      .map((c) => `${c.year}, ${c.papers.length}`)
      .join('; ')}. ${totals.map((t) => `${t.n} ${LABEL[t.state].toLowerCase()}`).join(', ')}. The full list follows.`}
  >
    {
      columns.map((col, i) => (
        <g>
          {/* the count, on the cap — four labels, not thirty-one */}
          <text class="pubfig-n" x={xOf(i) + COL / 2} y={TOP + plotH - col.papers.length * (BRICK + SPACER) - 6}>
            {col.papers.length}
          </text>

          {col.papers.map((p, n) => (
            <rect
              class:list={['pubfig-brick', `is-${stateOf(p.status)}`]}
              x={xOf(i)}
              y={yOf(n)}
              width={COL}
              height={BRICK}
            >
              <title>{`${p.title} — ${p.venue} (${LABEL[stateOf(p.status)]})`}</title>
            </rect>
          ))}

          <text class="pubfig-year" x={xOf(i) + COL / 2} y={TOP + plotH + 15}>{col.year}</text>
        </g>
      ))
    }

    {/* baseline: solid hairline, one step off the surface */}
    <line class="pubfig-base" x1="0" y1={TOP + plotH + 1} x2={W} y2={TOP + plotH + 1} />
  </svg>

  <ul class="pubfig-key">
    {
      totals.map((t) => (
        <li>
          <span class:list={['pubfig-swatch', `is-${t.state}`]} aria-hidden="true"></span>
          {LABEL[t.state]} <span class="pubfig-key-n">{t.n}</span>
        </li>
      ))
    }
  </ul>

  <figcaption class="pubfig-cap">
    <strong>Fig. 2</strong> — one block per paper. The axis is the four years with
    output, not a continuous scale: nothing sits between 2021 and 2025.
  </figcaption>
</figure>

<style>
  .pubfig {
    margin: 0 0 2rem;
  }

  .pubfig-svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    overflow: visible;
  }

  /* published: the second ink, solid */
  .pubfig-brick.is-published,
  .pubfig-swatch.is-published {
    fill: var(--ink-b);
    background: var(--ink-b);
  }

  /* accepted: the first ink, solid */
  .pubfig-brick.is-accepted,
  .pubfig-swatch.is-accepted {
    fill: var(--ink-a);
    background: var(--ink-a);
  }

  /**
   * In review: not printed yet. The stroke is the mark itself, not a separator
   * drawn around a fill — the blocks are held apart by the 2px surface gap.
   */
  .pubfig-brick.is-review {
    fill: none;
    stroke: var(--ink-hair);
    stroke-width: 1.4;
  }

  .pubfig-swatch.is-review {
    background: transparent;
    box-shadow: inset 0 0 0 1.4px var(--ink-hair);
  }

  /* text wears text tokens, never the data colour */
  .pubfig-n,
  .pubfig-year {
    font-family: var(--type);
    fill: var(--ink-faint);
    font-size: 11px;
    text-anchor: middle;
  }

  .pubfig-n {
    fill: var(--ink-soft);
    font-size: 12px;
  }

  .pubfig-base {
    stroke: var(--ink-hair);
    stroke-width: 1;
  }

  .pubfig-key {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .pubfig-key li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--type);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pubfig-swatch {
    width: 0.7rem;
    height: 0.42rem;
    flex: none;
  }

  .pubfig-key-n {
    color: var(--ink-faint);
  }

  .pubfig-cap {
    font-family: var(--type);
    font-size: 0.62rem;
    line-height: 1.6;
    color: var(--ink-faint);
    margin: 0.7rem 0 0;
    max-width: 30rem;
  }

  .pubfig-cap strong {
    color: var(--ink-soft);
  }
</style>
