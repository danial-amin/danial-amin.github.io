---
import projects from '../data/projects.json';
import { keepWordsWhole } from '../lib/type';
import Plate from './Plate.astro';

interface Props {
  featuredOnly?: boolean;
  showMore?: boolean;
  /**
   * The per-piece mark in the row rail. On by default — a list of fifty rows is
   * exactly where it earns its place — and off for the homepage teasers, where six
   * section plates already carry the graphic weight and more reads as busy.
   */
  plates?: boolean;
}
const { featuredOnly = true, showMore = true, plates = true } = Astro.props;
const items = projects.filter((p) => !featuredOnly || p.featured);
---

<ul class="listing" data-run>
  {
    items.map((p, i) => (
      <li style={`--i:${i}`}>
        <a class="entry" href={`/work/${p.id}`} data-lift>
          <span class="entry-num">
            {String(i + 1).padStart(2, '0')}
            {plates && <Plate seed={p.id} size={32} class="entry-plate" />}
          </span>
          <span class="entry-title"><mark>{keepWordsWhole(p.title)}</mark></span>
          <span class="entry-meta">{p.year}</span>
          <p class="entry-blurb">{p.outcome}</p>
        </a>
      </li>
    ))
  }
</ul>

{showMore && (
  <p style="margin:1.4rem 0 0" data-set>
    <a class="jump" href="/work">All case studies →</a>
  </p>
)}
