---
import projects from '../data/projects.json';

interface Props {
  /** false = every open project, not just the featured ones */
  featuredOnly?: boolean;
  showMore?: boolean;
}

const { featuredOnly = true, showMore = true } = Astro.props;
const items = projects.filter((p) => !p.locked && (!featuredOnly || p.featured));
---

<ul class="index-list" data-stagger>
  {
    items.map((p, i) => (
      <li style={`--i:${i}`}>
        <div class="index-row" data-prox>
          <span class="index-idx">{String(i + 1).padStart(2, '0')}</span>
          <span class="index-title">{p.title}</span>
          <span class="index-meta">{p.year}</span>
          <p class="index-blurb">{p.outcome}</p>
        </div>
      </li>
    ))
  }
</ul>

{
  showMore && (
    <p class="after-list" data-reveal>
      <a class="text-link" href="/work">
        All case studies <span class="arrow" aria-hidden="true">→</span>
      </a>
    </p>
  )
}
