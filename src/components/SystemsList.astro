---
import systems from '../data/systems.json';

interface Props {
  /** show the Why / What-shipped detail, or just the header row */
  detail?: boolean;
}

const { detail = true } = Astro.props;
---

<div class="panel-stack" data-stagger>
  {
    systems.map((s, i) => (
      <article class="panel" data-prox style={`--i:${i}`}>
        <p class="panel-id">SYS {String(i + 1).padStart(2, '0')}</p>

        <div class="panel-head">
          <div>
            <h3 class="panel-name">
              {/* the name goes to the on-site page; the live app is the CTA below */}
              <a href={`/systems/${s.id}`}>{s.name.split('—')[0].trim()}</a>
            </h3>
            <p class="panel-blurb">{s.blurb}</p>
          </div>
          <span class="panel-status">
            <span class="dot" aria-hidden="true" />
            {s.status}
          </span>
        </div>

        {detail && (
          <div class="panel-detail">
            <div>
              <p class="field-key">Why</p>
              <p class="field-why">{s.why}</p>
            </div>
            <div>
              <p class="field-key">What shipped</p>
              <p class="field-built">{s.built}</p>
            </div>
          </div>
        )}

        <p class="panel-foot panel-foot-split">
          <a class="text-link" href={`/systems/${s.id}`}>
            Read the case <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={s.url} rel="noopener noreferrer" target="_blank">
            Open live <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </p>
      </article>
    ))
  }
</div>
