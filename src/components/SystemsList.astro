---
import systems from '../data/systems.json';
---

<section class="section">
  <p class="section-label">Live systems</p>
  <h2 class="section-title" data-num="02 / Systems">Products I run</h2>
  <div class="case-stack">
    {
      systems.map((s) => (
        <article class="case-block">
          <header class="case-head">
            <div>
              <h3 class="case-name">
                <a href={s.url} rel="noopener noreferrer" target="_blank">
                  {s.name}
                </a>
              </h3>
              <p class="case-blurb">{s.blurb}</p>
            </div>
            <span class="case-status">{s.status}</span>
          </header>
          <div class="case-why">
            <p class="case-label">Why</p>
            <p>{s.why}</p>
          </div>
          <div class="case-built">
            <p class="case-label">What shipped</p>
            <p>{s.built}</p>
          </div>
          <p class="case-link">
            <a href={s.url} rel="noopener noreferrer" target="_blank">
              Open {s.name.split('—')[0].trim()} →
            </a>
          </p>
        </article>
      ))
    }
  </div>
</section>
