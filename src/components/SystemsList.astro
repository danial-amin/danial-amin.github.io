---
import systems from '../data/systems.json';
import Plate from './Plate.astro';

interface Props {
  detail?: boolean;
}
const { detail = true } = Astro.props;
---

<div class="cards" data-run>
  {
    systems.map((s, i) => (
      <article class="card" data-lift style={`--i:${i}`}>
        <div class="card-top">
          <span class="card-no">No. {String(i + 1).padStart(2, '0')}</span>
          <span class="card-state">{s.status}</span>
        </div>

        <Plate seed={s.id} size={56} variant="poster" class="card-plate" />

        <h3 class="card-name">
          <a href={`/systems/${s.id}`}>{s.name.split('—')[0].trim()}</a>
        </h3>
        <p class="card-blurb">{s.blurb}</p>

        {detail && (
          <>
            <div class="field">
              <p class="field-key">Why</p>
              <p class="field-why">{s.why}</p>
            </div>
            <div class="field">
              <p class="field-key">What shipped</p>
              <p class="field-built">{s.built}</p>
            </div>
          </>
        )}

        <p class="card-foot">
          <a class="jump" href={`/systems/${s.id}`}>Read the case</a>
          <a class="jump" href={s.url} rel="noopener noreferrer" target="_blank">Open live ↗</a>
        </p>
      </article>
    ))
  }
</div>
