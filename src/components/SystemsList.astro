---
import systems from '../data/systems.json';
---

<section class="section">
  <p class="section-label">Live systems</p>
  <h2 class="section-title">Products I run</h2>
  <div class="panel-stack">
    {
      systems.map((s, i) => (
        <article class="panel">
          <p class="panel-id">{String(i + 1).padStart(2, '0')} · system</p>
          <header class="panel-head">
            <div>
              <h3 class="panel-name">
                <a href={s.url} rel="noopener noreferrer" target="_blank">
                  {s.name}
                </a>
              </h3>
              <p class="panel-blurb">{s.blurb}</p>
            </div>
            <span class="panel-status">{s.status}</span>
          </header>
          <div class="panel-detail">
            <div>
              <p class="field-key">Why</p>
              <p class="field-why">{s.why}</p>
            </div>
            <div>
              <p class="field-key">What shipped</p>
              <p class="field-built">{s.built}</p>
            </div>
          </div>
          <p class="panel-foot">
            <a class="text-link" href={s.url} rel="noopener noreferrer" target="_blank">
              Open {s.name.split('—')[0].trim()} <span class="arrow">→</span>
            </a>
          </p>
        </article>
      ))
    }
  </div>
</section>
