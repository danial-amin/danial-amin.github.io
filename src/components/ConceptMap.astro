---
/**
 * Fig. 1 — an embedding map of the writing and the research.
 *
 * Geometry is computed from the corpus by scripts/build-concept-map.mjs
 * (tf-idf term vectors over 50 written pieces + 7 academic records → cosine
 * distance → classical MDS → k-means), so proximity here is real proximity in
 * the term space. Regenerate with `npm run map`.
 *
 * Four clusters out of two inks, because a Riso overprints: black, burgundy,
 * blue, and burgundy × blue multiplied into a fourth colour. Concepts that also
 * appear in the publications carry a ring.
 *
 * Interaction, in order of how much it earns its keep:
 *   - entry     dots fly out from their cluster centroid and settle, edges
 *               draw themselves — the map solving itself, which is what MDS
 *               literally does
 *   - focus     pointing at a concept lights its edges and its nearest
 *               neighbours and dims the rest, so the structure is readable
 *   - open      clicking one lists the pieces that use it, as links
 *   - isolate   the legend keys are filters
 *   - lens      an embedding map is illegible until you zoom, so only the
 *               densest concepts are labelled at rest and the loupe reads the
 *               small print at a true 3x
 */
import map from '../data/concept-map.json';

const { width: W, height: H, nodes, edges, docs, academicDocs } = map;

const byDocs = [...nodes].sort((a, b) => b.docs - a.docs);
const majorCutoff = byDocs[Math.min(19, byDocs.length - 1)]?.docs ?? 0;

// cluster centroids — where each dot flies in from
const centroids = [0, 1, 2, 3].map((c) => {
  const inC = nodes.filter((n) => n.cluster === c);
  if (!inC.length) return { x: W / 2, y: H / 2 };
  return {
    x: inC.reduce((s, n) => s + n.x, 0) / inC.length,
    y: inC.reduce((s, n) => s + n.y, 0) / inC.length,
  };
});

const clusterNames = [
  'behaviour & design',
  'data & language',
  'research & industry',
  'practice & tooling',
];

const edgeGeom = edges.map((e) => {
  const a = nodes[e.a];
  const b = nodes[e.b];
  return { ...e, len: Math.hypot(b.x - a.x, b.y - a.y) };
});

// which edges and neighbours belong to each node, for the focus state
const linked = nodes.map(() => ({ e: [] as number[], n: [] as number[] }));
edgeGeom.forEach((e, i) => {
  linked[e.a].e.push(i);
  linked[e.b].e.push(i);
  linked[e.a].n.push(e.b);
  linked[e.b].n.push(e.a);
});

const clientNodes = nodes.map((n, i) => ({
  t: n.term,
  d: n.docs,
  a: n.academic,
  c: n.cluster,
  x: n.x,
  y: n.y,
  nb: n.neighbours,
  u: n.used,
  e: linked[i].e,
  ln: linked[i].n,
}));
---

<figure class="fig" data-set>
  <div class="fig-plate" id="cm-plate">
    <svg class="cm-svg" id="cm-svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <g class="cm-edges">
        {
          edgeGeom.map((e, i) => (
            <line
              class="cm-edge"
              data-e={i}
              x1={nodes[e.a].x}
              y1={nodes[e.a].y}
              x2={nodes[e.b].x}
              y2={nodes[e.b].y}
              style={`--len:${e.len.toFixed(1)};--eo:${(e.s * 0.8).toFixed(2)};--ed:${(i % 24) * 26}ms`}
            />
          ))
        }
      </g>

      <g class="cm-dots">
        {
          nodes.map((n, i) => (
            <circle
              class:list={['cm-dot', `c${n.cluster}`, n.academic && 'is-academic']}
              data-n={i}
              cx={n.x}
              cy={n.y}
              r={n.r}
              style={`--dx:${(centroids[n.cluster].x - n.x).toFixed(1)}px;--dy:${(centroids[n.cluster].y - n.y).toFixed(1)}px;--nd:${(i % 30) * 22}ms`}
            />
          ))
        }
      </g>

      <g class="cm-labels">
        {
          nodes.map((n, i) =>
            n.docs >= majorCutoff ? (
              <text class="cm-major" data-l={i} x={n.x + n.r + 4} y={n.y + 5}>
                {n.term}
              </text>
            ) : null,
          )
        }
      </g>
    </svg>

    <div class="loupe" aria-hidden="true">
      <svg class="loupe-svg" viewBox={`0 0 ${W} ${H}`}>
        <g class="cm-edges">
          {
            edgeGeom.map((e) => (
              <line class="lp-edge" x1={nodes[e.a].x} y1={nodes[e.a].y} x2={nodes[e.b].x} y2={nodes[e.b].y} />
            ))
          }
        </g>
        <g class="cm-dots">
          {
            nodes.map((n) => (
              <circle
                class:list={['lp-dot', `c${n.cluster}`, n.academic && 'is-academic']}
                cx={n.x}
                cy={n.y}
                r={n.r}
              />
            ))
          }
        </g>
        <g class="cm-labels">
          {nodes.map((n) => <text class="cm-all" x={n.x + n.r + 3} y={n.y + 3}>{n.term}</text>)}
        </g>
      </svg>
    </div>
  </div>

  <figcaption class="fig-cap">
    <span id="cm-default">
      <strong>Fig. 1</strong> — {nodes.length} concepts from {docs} written pieces and {academicDocs}
      {' '}publications, placed by how they co-occur. Near = used together. Point, then click one.
    </span>
    <span id="cm-live" hidden></span>
  </figcaption>

  <div class="fig-tools">
    <p class="fig-key" role="group" aria-label="Isolate a cluster">
      {
        clusterNames.map((name, c) => (
          <button class={`k k${c}`} type="button" data-c={c} aria-pressed="false">{name}</button>
        ))
      }
      <button class="k k-ac" type="button" data-only-academic aria-pressed="false">academic</button>
    </p>
  </div>

  <div class="fig-panel" id="cm-panel" hidden>
    <p class="fig-panel-head">
      <span id="cm-panel-term"></span>
      <button class="fig-panel-x" type="button" id="cm-panel-close" aria-label="Close">×</button>
    </p>
    <ul id="cm-panel-list"></ul>
  </div>

  <details class="fig-list">
    <summary>Read the concepts as a list</summary>
    <ul>
      {
        byDocs.map((n) => (
          <li>
            {n.used[0] ? <a href={`/writing/${n.used[0].id}`}><b>{n.term}</b></a> : <b>{n.term}</b>}
            {n.academic && <span class="ac-tag">academic</span>}
            {' '}— in {n.docs} pieces · near {n.neighbours.join(', ')}
          </li>
        ))
      }
    </ul>
  </details>

  <script type="application/json" id="cm-data" set:html={JSON.stringify(clientNodes)} />
</figure>

<style>
  .fig {
    margin: 0;
  }

  .fig-plate {
    position: relative;
    border: 1.5px solid var(--ink-k);
    background: var(--paper-deep);
    overflow: hidden;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .cm-svg {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: var(--plate-blend);
  }

  /* ---- edges ---- */

  .cm-edge,
  .lp-edge {
    stroke: var(--ink-hair);
    stroke-width: 1.1;
  }

  .cm-edge {
    opacity: var(--eo);
    transition: opacity 200ms linear, stroke 200ms linear, stroke-width 200ms linear;
  }

  /* the map draws itself: each edge strokes on from nothing */
  .js .cm-edge {
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
  }

  .js .is-set .cm-edge {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--snap) var(--ed), opacity 200ms linear,
      stroke 200ms linear, stroke-width 200ms linear;
  }

  /* ---- dots ---- */

  .cm-dot,
  .lp-dot {
    mix-blend-mode: var(--plate-blend);
    opacity: 0.85;
  }

  .c0 {
    fill: var(--ink-k);
  }
  .c1 {
    fill: var(--ink-b);
  }
  .c2 {
    fill: var(--ink-a);
  }
  .c3 {
    fill: var(--ink-ab);
  }

  /* concepts that also appear in the publications */
  .is-academic {
    stroke: var(--ink-k);
    stroke-width: 1.6;
    paint-order: stroke;
  }

  /* dots fly out from their cluster centroid and settle — MDS converging */
  .js .cm-dot {
    transform: translate(var(--dx), var(--dy)) scale(0.4);
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
  }

  .js .is-set .cm-dot {
    transform: none;
    opacity: 0.85;
    transition: transform 1000ms var(--settle) var(--nd), opacity 420ms linear var(--nd);
  }

  /* ---- labels ---- */

  .cm-labels text {
    font-family: var(--type);
    fill: var(--ink-k);
  }

  .cm-major {
    font-size: 19px;
    letter-spacing: -0.02em;
    transition: opacity 200ms linear;
  }

  .cm-all {
    font-size: 11px;
  }

  .js .cm-major {
    opacity: 0;
  }

  .js .is-set .cm-major {
    opacity: 1;
    transition: opacity 500ms linear 700ms;
  }

  /* ---- focus state: read the structure ---- */

  .fig-plate[data-focus] .cm-dot {
    opacity: 0.14;
  }

  .fig-plate[data-focus] .cm-dot.is-near {
    opacity: 0.9;
  }

  .fig-plate[data-focus] .cm-dot.is-focus {
    opacity: 1;
    stroke: var(--ink-k);
    stroke-width: 2.4;
  }

  .fig-plate[data-focus] .cm-edge {
    opacity: 0.08;
  }

  .fig-plate[data-focus] .cm-edge.is-hot {
    opacity: 1;
    stroke: var(--ink-a);
    stroke-width: 2.4;
  }

  .fig-plate[data-focus] .cm-major {
    opacity: 0.2;
  }

  .fig-plate[data-focus] .cm-major.is-near,
  .fig-plate[data-focus] .cm-major.is-focus {
    opacity: 1;
  }

  /* ---- cluster isolation ---- */

  .fig-plate[data-only] .cm-dot,
  .fig-plate[data-only] .cm-major {
    opacity: 0.1;
  }

  .fig-plate[data-only] .cm-edge {
    opacity: 0.05;
  }

  .fig-plate[data-only='0'] .cm-dot.c0,
  .fig-plate[data-only='1'] .cm-dot.c1,
  .fig-plate[data-only='2'] .cm-dot.c2,
  .fig-plate[data-only='3'] .cm-dot.c3,
  .fig-plate[data-only='ac'] .cm-dot.is-academic {
    opacity: 0.95;
  }

  .fig-plate[data-only='0'] .cm-major.c0,
  .fig-plate[data-only='1'] .cm-major.c1,
  .fig-plate[data-only='2'] .cm-major.c2,
  .fig-plate[data-only='3'] .cm-major.c3,
  .fig-plate[data-only='ac'] .cm-major.is-academic {
    opacity: 1;
  }

  /* ---- caption ---- */

  .fig-cap {
    font-family: var(--type);
    font-size: 0.68rem;
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--paper);
    background: var(--ink-k);
    padding: 0.4rem 0.55rem;
    display: block;
  }

  .fig-cap strong {
    color: var(--paper);
  }

  /* ---- legend / filters ---- */

  .fig-tools {
    margin-top: 0.5rem;
  }

  .fig-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.4rem;
    margin: 0;
  }

  .k {
    font-family: var(--type);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.16rem 0.4rem;
    border: 1.5px solid var(--ink-hair);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .k::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.4em;
    border-radius: 50%;
  }

  .k0::before {
    background: var(--ink-k);
  }
  .k1::before {
    background: var(--ink-b);
  }
  .k2::before {
    background: var(--ink-a);
  }
  .k3::before {
    background: var(--ink-ab);
  }
  .k-ac::before {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--ink-k);
  }

  .k[aria-pressed='true'] {
    background: var(--ink-k);
    color: var(--paper);
    border-color: var(--ink-k);
  }

  /* ---- the pieces panel ---- */

  .fig-panel {
    margin-top: 0.5rem;
    border: 1.5px solid var(--ink-k);
    background: var(--paper);
    padding: 0.6rem 0.7rem;
  }

  .fig-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.4rem;
    font-family: var(--type);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-b);
  }

  .fig-panel-x {
    border: none;
    background: transparent;
    font-family: var(--type);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0 0.2rem;
  }

  .fig-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .fig-panel li + li {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1.5px dashed var(--ink-hair);
  }

  /* ---- text fallback ---- */

  .fig-list {
    margin-top: 0.6rem;
    font-family: var(--type);
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  .fig-list summary {
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-b);
  }

  .fig-list ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    max-height: 16rem;
    overflow-y: auto;
    line-height: 1.8;
  }

  .fig-list b {
    color: var(--ink-k);
  }

  .ac-tag {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1.5px solid var(--ink-hair);
    padding: 0 0.25em;
    margin-left: 0.3em;
  }

  /* ---- lens ---- */

  .loupe {
    position: absolute;
    width: 11rem;
    height: 11rem;
    left: var(--lx, 50%);
    top: var(--ly, 50%);
    margin: -5.5rem 0 0 -5.5rem;
    border-radius: 50%;
    border: 2.5px solid var(--ink-k);
    box-shadow: 0 5px 0 rgb(43 38 34 / 0.2);
    overflow: hidden;
    background: var(--paper);
    opacity: 0;
    transition: opacity 110ms linear;
    pointer-events: none;
  }

  .loupe.is-on {
    opacity: 1;
  }

  .loupe-svg {
    display: block;
    width: 100%;
    height: 100%;
    mix-blend-mode: var(--plate-blend);
  }

  @media (prefers-reduced-motion: reduce) {
    .loupe {
      display: none;
    }

    .js .cm-dot,
    .js .cm-major {
      transform: none !important;
      opacity: 0.85;
    }

    .js .cm-major {
      opacity: 1;
    }

    .js .cm-edge {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  type CNode = {
    t: string;
    d: number;
    a: boolean;
    c: number;
    x: number;
    y: number;
    nb: string[];
    u: { id: string; title: string }[];
    e: number[];
    ln: number[];
  };

  const plate = document.getElementById('cm-plate');
  const raw = document.getElementById('cm-data');
  const live = document.getElementById('cm-live');
  const dflt = document.getElementById('cm-default');
  const panel = document.getElementById('cm-panel');
  const panelTerm = document.getElementById('cm-panel-term');
  const panelList = document.getElementById('cm-panel-list');

  if (plate && raw && live && dflt && panel && panelTerm && panelList) {
    const data: CNode[] = JSON.parse(raw.textContent || '[]');
    const svg = document.getElementById('cm-svg') as SVGSVGElement | null;
    const lens = plate.querySelector('.loupe') as HTMLElement | null;
    const lensSvg = plate.querySelector('.loupe-svg') as SVGSVGElement | null;

    const dots = Array.from(plate.querySelectorAll<SVGCircleElement>('.cm-svg .cm-dot'));
    const lines = Array.from(plate.querySelectorAll<SVGLineElement>('.cm-svg .cm-edge'));
    const labels = new Map<number, SVGTextElement>();
    plate.querySelectorAll<SVGTextElement>('.cm-svg .cm-major').forEach((t) => {
      labels.set(Number(t.dataset.l), t);
    });

    // labels need cluster/academic classes for the isolate filter to reach them
    labels.forEach((el, i) => {
      el.classList.add(`c${data[i].c}`);
      if (data[i].a) el.classList.add('is-academic');
    });

    const vb = svg?.viewBox.baseVal;
    const VBW = vb?.width || 1000;
    const VBH = vb?.height || 620;
    const ZOOM = 3;

    let focused = -1;

    function clearFocus() {
      if (focused < 0) return;
      focused = -1;
      plate.removeAttribute('data-focus');
      dots.forEach((d) => d.classList.remove('is-focus', 'is-near'));
      lines.forEach((l) => l.classList.remove('is-hot'));
      labels.forEach((l) => l.classList.remove('is-focus', 'is-near'));
      live.hidden = true;
      dflt.hidden = false;
    }

    function setFocus(i: number) {
      if (i === focused) return;
      // only touches elements when the focused node actually changes
      dots.forEach((d) => d.classList.remove('is-focus', 'is-near'));
      lines.forEach((l) => l.classList.remove('is-hot'));
      labels.forEach((l) => l.classList.remove('is-focus', 'is-near'));

      focused = i;
      const n = data[i];
      plate.setAttribute('data-focus', String(i));
      dots[i]?.classList.add('is-focus');
      labels.get(i)?.classList.add('is-focus');
      for (const j of n.ln) {
        dots[j]?.classList.add('is-near');
        labels.get(j)?.classList.add('is-near');
      }
      for (const e of n.e) lines[e]?.classList.add('is-hot');

      live.textContent = `“${n.t}”${n.a ? ' · academic' : ''} — in ${n.d} of 50 pieces · nearest: ${n.nb.join(' · ')}`;
      live.hidden = false;
      dflt.hidden = true;
    }

    function nearest(cx: number, cy: number) {
      let best = -1;
      let bestD = Infinity;
      for (let i = 0; i < data.length; i++) {
        const d = (data[i].x - cx) ** 2 + (data[i].y - cy) ** 2;
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      }
      return bestD < 32 ** 2 ? best : -1;
    }

    function toUnits(e: PointerEvent | MouseEvent) {
      const r = plate.getBoundingClientRect();
      return {
        px: e.clientX - r.left,
        py: e.clientY - r.top,
        cx: ((e.clientX - r.left) / r.width) * VBW,
        cy: ((e.clientY - r.top) / r.height) * VBH,
        r,
      };
    }

    function openPanel(i: number) {
      const n = data[i];
      panelTerm.textContent = `“${n.t}” appears in`;
      panelList.innerHTML = '';
      if (!n.u.length) {
        const li = document.createElement('li');
        li.textContent = 'Only in the publications, not the essays.';
        panelList.append(li);
      }
      for (const u of n.u) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/writing/${u.id}`;
        a.textContent = u.title;
        li.append(a);
        panelList.append(li);
      }
      panel.hidden = false;
    }

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (fine.matches) {
      plate.addEventListener(
        'pointermove',
        (e) => {
          const { px, py, cx, cy, r } = toUnits(e);

          if (lens && lensSvg && !still.matches) {
            lens.style.setProperty('--lx', `${px}px`);
            lens.style.setProperty('--ly', `${py}px`);
            // window sized from the real rendered scale, so it's a true 3x
            const region = (lens.offsetWidth * (VBW / r.width)) / ZOOM;
            lensSvg.setAttribute(
              'viewBox',
              `${cx - region / 2} ${cy - region / 2} ${region} ${region}`,
            );
            lens.classList.add('is-on');
          }

          const i = nearest(cx, cy);
          if (i >= 0) setFocus(i);
          else clearFocus();
        },
        { passive: true },
      );

      plate.addEventListener('pointerleave', () => {
        lens?.classList.remove('is-on');
        clearFocus();
      });
    }

    plate.addEventListener('click', (e) => {
      const { cx, cy } = toUnits(e);
      const i = nearest(cx, cy);
      if (i >= 0) openPanel(i);
    });

    document.getElementById('cm-panel-close')?.addEventListener('click', () => {
      panel.hidden = true;
    });

    // legend keys isolate a cluster (or the academic concepts)
    const keys = Array.from(plate.parentElement?.querySelectorAll<HTMLButtonElement>('.k') ?? []);
    keys.forEach((btn) => {
      btn.addEventListener('click', () => {
        const want = btn.dataset.c ?? 'ac';
        const on = plate.getAttribute('data-only') === want;
        keys.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        if (on) {
          plate.removeAttribute('data-only');
        } else {
          plate.setAttribute('data-only', want);
          btn.setAttribute('aria-pressed', 'true');
        }
      });
    });
  }
</script>
