---
import { selected, cite } from '../lib/publications';
import news from '../data/news.json';
import site from '../data/site.json';
import { academicHome } from '../lib/origins';
import { keepWordsWhole } from '../lib/type';

/**
 * The three that should meet a reader first.
 *
 * This used to be `publications.slice(0, 3)`, and publications.json is sorted by
 * year then title — so the homepage led with whichever paper happened to sort
 * first, which was an under-review submission. The order is now stated in the
 * data (`selected`) rather than fallen into.
 */
const top = selected.slice(0, 3);
const latest = news[0];
---

<ul class="listing" data-run>
  {
    top.map((p, i) => (
      <li style={`--i:${i}`}>
        <div class="entry" data-lift>
          <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="entry-title" style="font-family:var(--body);font-weight:700;font-size:1rem;text-transform:none">
            {keepWordsWhole(p.title)}
          </span>
          <span class="entry-meta">{cite(p)}</span>
          <p class="entry-blurb">{p.status}</p>
        </div>
      </li>
    ))
  }
</ul>

{latest && (
  <div class="crosslink" data-set>
    <p class="field-key">Latest · {latest.date}</p>
    <p>{latest.text}</p>
  </div>
)}

<p style="margin:1.4rem 0 0" data-set>
  <a class="jump" href={academicHome} rel="noopener noreferrer" target="_blank">
    Full academic record ↗
  </a>
</p>
