---
import publications from '../data/publications.json';
import news from '../data/news.json';
import site from '../data/site.json';
import { academicHome } from '../lib/origins';

const top = publications.slice(0, 3);
const latest = news[0];
---

<ul class="listing" data-run>
  {
    top.map((p, i) => (
      <li style={`--i:${i}`}>
        <div class="entry" data-lift>
          <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="entry-title" style="font-family:var(--body);font-weight:700;font-size:1rem;text-transform:none">
            {p.title}
          </span>
          <span class="entry-meta">{p.venue} · {p.year}</span>
          <p class="entry-blurb">{p.status}</p>
        </div>
      </li>
    ))
  }
</ul>

{latest && (
  <div class="crosslink" data-set>
    <p class="field-key">Latest · {latest.date}</p>
    <p>{latest.text}</p>
  </div>
)}

<p style="margin:1.4rem 0 0" data-set>
  <a class="jump" href={academicHome} rel="noopener noreferrer" target="_blank">
    Full academic record ↗
  </a>
</p>
