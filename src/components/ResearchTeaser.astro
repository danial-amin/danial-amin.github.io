---
import publications from '../data/publications.json';
import news from '../data/news.json';
import site from '../data/site.json';

const top = publications.slice(0, 3);
const latest = news[0];
---

<ul class="index-list" data-stagger>
  {
    top.map((p, i) => (
      <li style={`--i:${i}`}>
        <div class="index-row" data-prox>
          <span class="index-idx">{String(i + 1).padStart(2, '0')}</span>
          <span class="index-title pub-title">{p.title}</span>
          <span class="index-meta">
            {p.venue} · {p.year}
          </span>
          <p class="index-blurb">{p.status}</p>
        </div>
      </li>
    ))
  }
</ul>

{
  latest && (
    <div class="latest-note" data-reveal>
      <p class="field-key">Latest · {latest.date}</p>
      <p class="field-built">{latest.text}</p>
    </div>
  )
}

<p class="after-list" data-reveal>
  <a class="text-link" href={site.academicUrl} rel="noopener noreferrer" target="_blank">
    Full academic record <span class="arrow" aria-hidden="true">↗</span>
  </a>
</p>
