---
import type { Post } from '../lib/writing';
import { keepWordsWhole } from '../lib/type';
import Plate from './Plate.astro';

interface Props {
  posts: Post[];
  alternatesFor?: Map<string, Post[]>;
  limit?: number;
  showMore?: boolean;
  numbered?: boolean;
  /**
   * The per-piece mark in the row rail. On by default — a list of fifty rows is
   * exactly where it earns its place — and off for the homepage teasers, where six
   * section plates already carry the graphic weight and more reads as busy.
   */
  plates?: boolean;
}
const { posts, alternatesFor, limit, showMore = false, numbered = true, plates = true } =
  Astro.props;
const sorted = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = limit ? sorted.slice(0, limit) : sorted;

/**
 * Pinned to UTC on purpose.
 *
 * A frontmatter `date: 2026-08-06` is a calendar day, but zod coerces it to an
 * instant — midnight UTC — and formatting an instant without a zone uses whatever
 * zone the renderer happens to be in. These pages are prerendered, so that is the
 * build machine: Railway is UTC and the dates come out right today, but a build
 * anywhere west of UTC would silently print every post a day early (New York and
 * Los Angeles both render that date as 5 August). UTC in, UTC out.
 */
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    timeZone: 'UTC',
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });

function kind(post: Post) {
  const alts = alternatesFor?.get(post.id) ?? [];
  if (alts.length) return 'Essay + Newsletter';
  return post.data.source === 'newsletter' ? 'Newsletter' : 'Essay';
}
---

<ul class="listing" id="writing-list" data-run>
  {
    items.map((post, i) => (
      <li
        data-source={post.data.source}
        data-both={(alternatesFor?.get(post.id) ?? []).length ? 'true' : undefined}
        style={`--i:${i}`}
      >
        <a class="entry" href={`/writing/${post.id}`} data-lift>
          {numbered && (
            <span class="entry-num">
              {String(i + 1).padStart(2, '0')}
              {plates && <Plate seed={post.id} size={32} class="entry-plate" />}
            </span>
          )}
          <span class="entry-title"><mark>{keepWordsWhole(post.data.title)}</mark></span>
          <span class="entry-meta">{kind(post)} · {fmt(post.data.date)}</span>
          <p class="entry-blurb">{post.data.excerpt}</p>
        </a>
      </li>
    ))
  }
</ul>

{showMore && (
  <p style="margin:1.4rem 0 0" data-set>
    <a class="jump" href="/writing">All writing →</a>
  </p>
)}
