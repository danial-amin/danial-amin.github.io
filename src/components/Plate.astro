---
/**
 * The plate for one piece — see src/lib/plate.ts for how it is composed.
 *
 * Printed twice, like everything else here: the burgundy pass sits underneath and
 * multiplies, offset by a unit or two, and the black pass lands on top. Both use
 * the stock's ink variables, so the plate follows the paper into black without a
 * second palette.
 *
 * Decorative, so it is aria-hidden — the title beside it is the content.
 */
import { plateFor, pathFor } from '../lib/plate';

interface Props {
  /** anything stable per piece; the post id is what we use */
  seed: string;
  /** rendered size in px */
  size?: number;
  class?: string;
}

const { seed, size = 72, class: cls } = Astro.props;
const plate = plateFor(seed);
const [ox, oy] = plate.offset;
---

<svg
  class:list={['plate', cls]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <g transform={`rotate(${plate.rotate.toFixed(2)} 50 50)`}>
    {/* the second ink, out of register */}
    <g class="plate-a" transform={`translate(${ox.toFixed(2)} ${oy.toFixed(2)})`}>
      {plate.shapes.map((shape) => {
        const g = pathFor(shape);
        const turn = `rotate(${shape.turn * 90} ${shape.x + shape.s / 2} ${shape.y + shape.s / 2})`;
        return (
          <g transform={turn}>
            {g.d && <path d={g.d} />}
            {g.circle && (
              <circle cx={g.circle.cx} cy={g.circle.cy} r={g.circle.r} fill="none" stroke-width={g.circle.w} />
            )}
            {g.rects?.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
          </g>
        );
      })}
    </g>

    {/* the black pass */}
    <g class="plate-k">
      {plate.shapes.map((shape) => {
        const g = pathFor(shape);
        const turn = `rotate(${shape.turn * 90} ${shape.x + shape.s / 2} ${shape.y + shape.s / 2})`;
        return (
          <g transform={turn}>
            {g.d && <path d={g.d} />}
            {g.circle && (
              <circle cx={g.circle.cx} cy={g.circle.cy} r={g.circle.r} fill="none" stroke-width={g.circle.w} />
            )}
            {g.rects?.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
          </g>
        );
      })}
    </g>
  </g>
</svg>

<style>
  .plate {
    display: block;
    flex: none;
  }

  .plate-k {
    fill: var(--ink-k);
    stroke: var(--ink-k);
  }

  .plate-a {
    fill: var(--ink-a);
    stroke: var(--ink-a);
    mix-blend-mode: var(--plate-blend);
  }
</style>
