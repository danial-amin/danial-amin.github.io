---
import site from '../data/site.json';
---

<p class="lede" data-reveal>
  Founders, labs, and peers — if the problem needs agentic systems, fairer user
  representations, or a technical partner who argues with the brief before writing code,
  write to me.
</p>

<div class="hero-actions" data-reveal style="--reveal-delay:90ms">
  <a class="btn" href={`mailto:${site.email}`}><span>{site.cta}</span></a>
  <a class="btn btn-ghost" href={site.cv}><span>Download CV</span></a>
</div>
