---
import site from '../data/site.json';
---

<p class="lede" data-set>
  Founders, labs, and peers — if the problem needs agentic systems, fairer user
  representations, or a technical partner who argues with the brief before writing code,
  write to me.
</p>

<div class="cover-actions" data-set style="--set-delay:80ms">
  <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
  <a class="btn btn-out" href={site.cv}>Download CV</a>
</div>
