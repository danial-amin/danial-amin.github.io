---
import site from '../data/site.json';
---

<section class="section" id="contact">
  <p class="section-label">Contact</p>
  <h2 class="section-title" data-num="06 / Contact">Build something clear</h2>
  <p style="max-width:36rem;margin:0 0 1.25rem;color:var(--ink-muted)">
    Founders, labs, and peers — if the problem needs agentic systems, fairer representations, or a sharp technical partner, write.
  </p>
  <div class="hero-meta">
    <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
    <a class="btn btn-ghost" href={site.cv}>Download CV</a>
  </div>
</section>
