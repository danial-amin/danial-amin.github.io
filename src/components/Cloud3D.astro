---
/**
 * Fig. 1 — the concept space as a rotating 3D point cloud.
 *
 * The academic site carries the full three-pane projector; this is the reduced
 * version of the same idea — the cloud and nothing else. No projection switcher,
 * no colour-by, no left rail. Drag to orbit, scroll-free, hover for a label,
 * click for the pieces that use a concept.
 *
 * Coordinates are a 3-dimensional classical MDS of the same cosine distance
 * matrix (scripts/build-concept-map.mjs), so this is one eigenvector further
 * into the same decomposition rather than a different embedding. Rotation is a
 * plain Y/X matrix applied per frame to 210 points, which is cheap enough to run
 * in SVG and keeps the labels as real text.
 *
 * Eight k-means groups, eight inks, keyed underneath by .cl-key — the generator
 * names each group after its most-used concept so the key cannot drift from the
 * colours when a new post changes the grouping.
 */
import map from '../data/concept-map.json';
import { academicPublications } from '../lib/origins';

const { nodes, cloud, docs, academicDocs, dims, groups } = map;

// how many carry a larger label at rest; the rest are still drawn, just quieter
const cutoff = [...nodes].sort((a, b) => b.docs - a.docs)[Math.min(23, nodes.length - 1)]?.docs ?? 0;

const client = nodes.map((n, i) => ({
  t: n.term,
  d: n.docs,
  p: n.papers,
  a: n.academic,
  c: n.cluster,
  r: n.r,
  big: n.docs >= cutoff,
  nb: n.neighbours.slice(0, 4),
  u: n.used.slice(0, 4),
  v: cloud[i],
}));
---

<figure class="cl" data-set>
  <div class="cl-stage" id="clStage">
    <svg viewBox="-196 -94 392 296" id="clSvg" role="img"
      aria-label={`Rotating three-dimensional embedding of ${nodes.length} concepts from ${docs} essays and ${academicDocs} publications.`}>
      <g id="clPts"></g>
    </svg>

    <p class="cl-badge">
      <span>3D · MDS</span>
      <span>{nodes.length} concepts</span>
      <span>{dims} dims</span>
    </p>
  </div>

  <!-- Everything below the drawing. Grouped so the cover can put the cloud's base
       on the same line as the buttons beside it and let this follow underneath. -->
  <div class="cl-under">
    <p class="cl-hint" id="clHint">Drag to turn · click a word to open it</p>

    <ul class="cl-key" aria-label="Concept groups, by ink">
      {groups.map((g) => (
        <li class:list={[`k${g.k}`]} title={g.also.length ? `also: ${g.also.join(', ')}` : undefined}>
          <span class="cl-key-dot" aria-hidden="true"></span>
          <span class="cl-key-t">{g.label}</span>
          <span class="cl-key-n">{g.size}</span>
        </li>
      ))}
    </ul>

    <!-- underneath, so it never covers the thing it describes -->
    <div class="cl-read" id="clRead" hidden></div>

    <figcaption class="cl-cap">
    <strong>Fig. 1</strong> — {nodes.length} concepts from {docs} essays and {academicDocs}
    {' '}publications, placed by co-occurrence in three dimensions. Ringed points also appear in the
    papers. <a href={academicPublications} rel="noopener" target="_blank">The
    full projector is on the academic site ↗</a>
    </figcaption>
  </div>

  <script type="application/json" id="clData" set:html={JSON.stringify(client)} />
</figure>

<style>
  /* No frame and no fill — the words sit directly on the paper. */
  .cl {
    margin: 0;
  }

  .cl-stage {
    position: relative;
    cursor: grab;
    touch-action: pan-y;
  }

  .cl-stage.dragging {
    cursor: grabbing;
  }

  .cl-stage svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /**
   * These all have to be :global.
   *
   * The nodes are created with createElementNS at runtime, so they never carry
   * the component's scope attribute — and a scoped selector compiles to
   * `.cl-dot[data-astro-cid-x]`, which cannot match them. Every rule in here was
   * dead: the dots fell back to the SVG default of solid black, which is why the
   * cloud looked like one colour, and the labels were never coloured at all.
   */
  .cl-stage :global(.cl-node) {
    cursor: pointer;
  }

  /* a generous invisible target, so a 3px dot is not the thing you must hit */
  .cl-stage :global(.cl-hit) {
    fill: transparent;
    stroke: none;
  }

  .cl-stage :global(.cl-dot) {
    mix-blend-mode: normal;
  }

  .cl-stage :global(.cl-dot.k0) { fill: var(--c0); }
  .cl-stage :global(.cl-dot.k1) { fill: var(--c1); }
  .cl-stage :global(.cl-dot.k2) { fill: var(--c2); }
  .cl-stage :global(.cl-dot.k3) { fill: var(--c3); }
  .cl-stage :global(.cl-dot.k4) { fill: var(--c4); }
  .cl-stage :global(.cl-dot.k5) { fill: var(--c5); }
  .cl-stage :global(.cl-dot.k6) { fill: var(--c6); }
  .cl-stage :global(.cl-dot.k7) { fill: var(--c7); }

  .cl-stage :global(.cl-dot.ac) {
    stroke: var(--ink-k);
    stroke-width: 0.6;
    paint-order: stroke;
  }

  .cl-stage :global(.cl-lab) {
    font-family: var(--type);
    pointer-events: none;
  }

  .cl-stage :global(.cl-lab.k0) { fill: var(--c0); }
  .cl-stage :global(.cl-lab.k1) { fill: var(--c1); }
  .cl-stage :global(.cl-lab.k2) { fill: var(--c2); }
  .cl-stage :global(.cl-lab.k3) { fill: var(--c3); }
  .cl-stage :global(.cl-lab.k4) { fill: var(--c4); }
  .cl-stage :global(.cl-lab.k5) { fill: var(--c5); }
  .cl-stage :global(.cl-lab.k6) { fill: var(--c6); }
  .cl-stage :global(.cl-lab.k7) { fill: var(--c7); }

  .cl-stage :global(.cl-node.hot .cl-lab),
  .cl-stage :global(.cl-node.on .cl-lab) {
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 1.4;
  }

  .cl-stage :global(.cl-node.on .cl-dot),
  .cl-stage :global(.cl-node.pinned .cl-dot) {
    stroke: var(--ink-k);
    stroke-width: 1.2;
    paint-order: stroke;
  }

  .cl-badge,
  .cl-hint {
    position: absolute;
    /* they sit over the svg, so they must not intercept a press */
    pointer-events: none;
    margin: 0;
    font-family: var(--type);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .cl-badge {
    top: 0.45rem;
    left: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  /**
   * Under the drawing rather than over it. It used to sit inside the stage at the
   * bottom right, which was empty space only because the viewBox carried 96 units
   * of padding down there; with the box fitted to the words the hint landed on top
   * of them.
   */
  .cl-hint {
    position: static;
    margin: 0.5rem 0 0;
  }

  /**
   * The key to the inks.
   *
   * Eight groups come out of k-means over the term vectors, and until now the
   * colours were unexplained — eight inks with nothing saying what they separate.
   * Each row is named after the concept that carries its group (the term in the
   * most pieces), which the generator emits alongside the clusters so the labels
   * cannot fall out of step with the colours after a publish. Hover gives the next
   * two terms.
   *
   * The swatches read from the same --c0..--c7 the dots use, so the key follows the
   * paper stock into black without a second palette.
   */
  .cl-key {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin: 0.7rem 0 0;
    padding: 0;
  }

  .cl-key li {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--type);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: default;
  }

  .cl-key-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    flex: none;
    /* the dots in the cloud carry the same ink at partial opacity by depth */
    background: var(--ink-k);
  }

  .cl-key li.k0 .cl-key-dot { background: var(--c0); }
  .cl-key li.k1 .cl-key-dot { background: var(--c1); }
  .cl-key li.k2 .cl-key-dot { background: var(--c2); }
  .cl-key li.k3 .cl-key-dot { background: var(--c3); }
  .cl-key li.k4 .cl-key-dot { background: var(--c4); }
  .cl-key li.k5 .cl-key-dot { background: var(--c5); }
  .cl-key li.k6 .cl-key-dot { background: var(--c6); }
  .cl-key li.k7 .cl-key-dot { background: var(--c7); }

  .cl-key-n {
    font-size: 0.55rem;
    color: var(--ink-faint);
  }

  .cl-read {
    position: static;
    margin: 0.6rem 0 0;
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--ink-k);
    background: var(--paper);
    border: 2px solid var(--ink-k);
    box-shadow: 4px 4px 0 var(--ink-a);
  }

  .cl-read :global(.cl-r-h) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0;
    padding: 0.3rem 0.45rem;
    background: var(--ink-k);
    color: var(--paper);
  }

  .cl-read :global(.cl-r-h b) {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 0.82rem;
  }

  .cl-read :global(.cl-r-h .dim) {
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  /* neighbours as chips with their distance, rather than a run-on line */
  .cl-read :global(.cl-r-nb) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    margin: 0;
    padding: 0.35rem 0.45rem;
    border-bottom: 1.5px dashed var(--ink-hair);
  }

  .cl-read :global(.cl-nb) {
    font-family: var(--type);
    font-size: 0.6rem;
    border: 1.5px solid var(--ink-hair);
    padding: 0.02rem 0.28rem;
    color: var(--ink-soft);
  }

  .cl-read :global(.cl-nb i) {
    font-style: normal;
    margin-left: 0.3em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .cl-read :global(.cl-r-l) {
    margin: 0;
    padding: 0.3rem 0.45rem 0.1rem;
    font-family: var(--type);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-a);
  }

  /* the links are the point of pinning, so they are rows you can hit */
  .cl-read :global(.cl-r-u) {
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
  }

  .cl-read :global(.cl-r-u li) {
    border-top: 1.5px dashed var(--ink-hair);
  }

  .cl-read :global(.cl-r-u a) {
    display: block;
    padding: 0.28rem 0.45rem;
    color: var(--ink-k);
    text-decoration: none;
    line-height: 1.35;
  }

  .cl-read :global(.cl-r-u a::before) {
    content: '→ ';
    color: var(--ink-a);
  }

  .cl-read :global(.cl-r-u a:hover) {
    background: var(--ink-a);
    color: var(--on-a);
  }

  .cl-read :global(.cl-r-u a:hover::before) {
    color: var(--on-a);
  }

  /* the pinned ring is declared with the other node styles, as :global */

  .cl-cap {
    font-family: var(--type);
    font-size: 0.64rem;
    line-height: 1.6;
    color: var(--paper);
    background: var(--ink-k);
    padding: 0.35rem 0.7rem;
  }

  .cl-cap strong,
  .cl-cap a {
    color: var(--paper);
  }

  .cl-cap a:hover {
    background: var(--ink-a);
    color: var(--on-a);
  }
</style>

<script>
  type CN = {
    t: string; d: number; p: number; a: boolean; c: number; r: number; big: boolean;
    nb: { term: string; d: number }[];
    u: { id: string; title: string }[];
    v: [number, number, number];
  };

  const stage = document.getElementById('clStage');
  const raw = document.getElementById('clData');
  const group = document.getElementById('clPts');
  // the frame is computed from the geometry in fitViewBox, not authored in the markup
  const svg = document.getElementById('clSvg');

  if (stage && raw && group && svg) {
    const nodes = JSON.parse(raw.textContent || '[]') as CN[];
    const read = document.getElementById('clRead')!;
    const hint = document.getElementById('clHint')!;
    const SVGNS = 'http://www.w3.org/2000/svg';
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    // one <g> per concept, built once and repositioned per frame
    const els = nodes.map((n) => {
      const g = document.createElementNS(SVGNS, 'g');
      g.setAttribute('class', 'cl-node');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', `${n.t}, in ${n.d} essays`);

      /**
       * The target is a rect covering the dot AND the label, because the label is
       * what people aim at. It was a small circle centred on the dot while the
       * word ran off to the right outside it — so clicking a word hit nothing at
       * all, which is exactly what it felt like.
       */
      const hit = document.createElementNS(SVGNS, 'rect');
      hit.setAttribute('class', 'cl-hit');

      const c = document.createElementNS(SVGNS, 'circle');
      c.setAttribute('class', `cl-dot k${n.c}${n.a ? ' ac' : ''}`);
      const t = document.createElementNS(SVGNS, 'text');
      t.setAttribute('class', `cl-lab k${n.c}`);
      t.textContent = n.t;

      g.append(hit, c, t);
      group.append(g);
      return { g, c, t, hit };
    });

    /**
     * Label widths, measured once at a reference size. getComputedTextLength is
     * a layout read, so it happens here rather than per frame, and the per-frame
     * width is just a proportional scale of it. Re-measured after the webfont
     * lands, since Courier Prime replaces the fallback and the metrics change.
     */
    const REF = 10;
    let widths = new Float64Array(nodes.length);

    function measure() {
      els.forEach((e, i) => {
        e.t.setAttribute('font-size', String(REF));
        try {
          widths[i] = e.t.getComputedTextLength();
        } catch {
          widths[i] = nodes[i].t.length * REF * 0.6;
        }
      });
    }
    measure();
    document.fonts?.ready.then(() => {
      measure();
      fitViewBox();
      frame();
    });

    let yaw = 0.6;
    let pitch = -0.25;
    let spin = still.matches ? 0 : 0.0022;
    let picked = -1;
    /**
     * Pinned selection. Without it the readout cleared on pointerleave, so its
     * links vanished the moment you moved toward them — they were unreachable
     * rather than broken. Pinning also freezes the drift, so the thing you are
     * reading about stops moving.
     */
    let pinned = -1;

    const SCALE = 142;
    const DEPTH = 2.6; // perspective divisor

    /**
     * Fit the viewBox to what the cloud can actually reach.
     *
     * The box used to be four hand-tuned numbers, retuned by hand every time the
     * spread or the type size changed — and it was wrong in every direction. A
     * word is drawn as a dot plus a label running off to its right, its size
     * scaled by the perspective divisor, so the furthest thing from the origin is
     * not a point at radius 1: it is a long word on a near point, where |v| can be
     * sqrt(3) and k up to DEPTH/(DEPTH - sqrt(3)) ~ 3. "Registration" at the front
     * of the cloud reached well past x = 196 and was simply cut off, and because
     * yaw spins continuously, every word took its turn at being clipped.
     *
     * So the extent is measured rather than guessed: sample the orientations the
     * cloud can be in — yaw all the way round, pitch over the range the drag
     * handler clamps to — project every word with the same arithmetic frame()
     * uses, and take the union of the label boxes. 64 x 25 orientations is a few
     * milliseconds, once, and it cannot disagree with the renderer because it is
     * the same formulas.
     *
     * Widths come from measure(), so this runs again once the webfont lands and
     * Courier Prime's metrics replace the fallback's.
     */
    function fitViewBox() {
      let minX = Infinity;
      let maxX = -Infinity;
      let minY = Infinity;
      let maxY = -Infinity;

      const YAWS = 72;

      {
        /**
         * Only yaw is swept. Pitch is whatever the reader has tilted it to, and it
         * only changes by dragging — so the envelope that matters is the one full
         * turn at the current pitch, not the whole sphere.
         *
         * Fitting the sphere instead was the first attempt and it cost a third of
         * the figure: it reserved room for excursions that only happen at extreme
         * tilts, so the cloud sat small and off-centre in a mostly empty frame.
         * The drag handler calls this again whenever pitch moves, which is why the
         * tighter box is safe.
         */
        const cp = Math.cos(pitch);
        const sp = Math.sin(pitch);

        for (let a = 0; a < YAWS; a++) {
          const t = (a / YAWS) * Math.PI * 2;
          const cy = Math.cos(t);
          const sy = Math.sin(t);

          for (let i = 0; i < nodes.length; i++) {
            const [x0, y0, z0] = nodes[i].v;
            const x1 = x0 * cy - z0 * sy;
            const z1 = x0 * sy + z0 * cy;
            const y1 = y0 * cp - z1 * sp;
            const z2 = y0 * sp + z1 * cp;
            const k = DEPTH / (DEPTH + z2);

            const x = x1 * SCALE * k;
            const y = y1 * SCALE * k;
            const r = nodes[i].r * 0.46 * k;
            const fs = (nodes[i].big ? 6.4 : 5) * k;
            const textW = widths[i] * (fs / REF);

            // the same box the hit rect and the label occupy in frame()
            if (x - r - 3 < minX) minX = x - r - 3;
            if (x + r + 5 + textW > maxX) maxX = x + r + 5 + textW;
            if (y - fs * 0.9 < minY) minY = y - fs * 0.9;
            if (y + fs * 0.9 > maxY) maxY = y + fs * 0.9;
          }
        }
      }

      /**
       * A uniform margin, and the cloud sits centred.
       *
       * The old box was asymmetric — y from -94 to 202, the cloud pushed up into
       * the top third — and two commits went into nudging that offset. It was
       * compensating for this bug: the top was clipping by 171 units, so the cloud
       * looked bottom-heavy and the fix was applied to the framing instead of the
       * frame. With the extent measured properly the offset is not needed. The
       * badge and the caption are corner overlays with pointer-events: none, so
       * they need no reserved space of their own.
       */
      /**
       * No margin along the bottom: the cover puts the key directly under the
       * drawing and aligns the figure on that edge, so the lowest word's descender
       * is where the box should end. Eight units of padding there read as the cloud
       * floating off its own legend.
       */
      const M = 8;
      const x = minX - M;
      const y = minY - M;
      const w = maxX - minX + M * 2;
      const h = maxY - minY + M;
      svg.setAttribute('viewBox', `${x.toFixed(1)} ${y.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`);
    }

    function frame() {
      const cy = Math.cos(yaw);
      const sy = Math.sin(yaw);
      const cp = Math.cos(pitch);
      const sp = Math.sin(pitch);

      // rotate, project, and collect for depth sorting
      const order: { i: number; z: number; x: number; y: number; k: number }[] = [];
      for (let i = 0; i < nodes.length; i++) {
        const [x0, y0, z0] = nodes[i].v;
        const x1 = x0 * cy - z0 * sy;
        const z1 = x0 * sy + z0 * cy;
        const y1 = y0 * cp - z1 * sp;
        const z2 = y0 * sp + z1 * cp;
        const k = DEPTH / (DEPTH + z2); // nearer = larger
        order.push({ i, z: z2, x: x1 * SCALE * k, y: y1 * SCALE * k, k });
      }
      // painter's algorithm: far points first, so near ones sit on top
      order.sort((a, b) => b.z - a.z);

      for (const o of order) {
        const n = nodes[o.i];
        const e = els[o.i];
        e.g.setAttribute('transform', `translate(${o.x.toFixed(2)} ${o.y.toFixed(2)})`);
        const r = n.r * 0.46 * o.k;
        e.c.setAttribute('r', r.toFixed(2));
        e.c.setAttribute('fill-opacity', (0.62 + o.k * 0.38).toFixed(2));
        /**
         * Every word is drawn. With 140 of them the crowd is managed by depth
         * rather than by hiding: those at the back are smaller and fainter, so
         * the front of the cloud reads and the back becomes texture. The
         * prominent concepts and the selected one are always fully opaque.
         */
        const front = (o.k - 0.72) / 0.5; // roughly 0 at the back, 1 at the front
        const fade = Math.max(0.16, Math.min(1, front));
        const lit = n.big || o.i === picked;
        const fs = (n.big ? 6.4 : 5) * o.k;
        e.t.setAttribute('x', (r + 2).toFixed(2));
        e.t.setAttribute('y', (fs * 0.34).toFixed(2));
        e.t.setAttribute('font-size', fs.toFixed(2));

        // the target: from just left of the dot to just past the end of the word
        const textW = widths[o.i] * (fs / REF);
        e.hit.setAttribute('x', (-r - 3).toFixed(2));
        e.hit.setAttribute('y', (-fs * 0.85).toFixed(2));
        e.hit.setAttribute('width', (r * 2 + 6 + textW + 3).toFixed(2));
        e.hit.setAttribute('height', (fs * 1.75).toFixed(2));
        e.t.setAttribute('opacity', (lit ? Math.max(0.55, fade) : fade * 0.82).toFixed(2));
        // reorder for depth
        group.append(e.g);
      }
    }

    let rafId = 0;
    function loop() {
      if (spin) yaw += spin;
      frame();
      rafId = requestAnimationFrame(loop);
    }

    /* ---- orbit ---- */

    /**
     * Drag has to be distinguished from click, and the pointer must NOT be
     * captured until it is genuinely a drag.
     *
     * The previous version called setPointerCapture on pointerdown, which
     * redirects every following pointer event — and the click generated from
     * them — to the stage. A node's own click handler therefore never fired, so
     * concepts could not be selected and their links were unreachable. Capture
     * now waits for real movement, and a press that never moves is left alone to
     * become a click.
     */
    const DRAG_THRESHOLD = 4;
    let pressing = false;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let lastY = 0;
    let pointerId = -1;

    stage.addEventListener('pointerdown', (e) => {
      pressing = true;
      dragging = false;
      pointerId = e.pointerId;
      startX = lastX = e.clientX;
      startY = lastY = e.clientY;
    });

    stage.addEventListener('pointermove', (e) => {
      if (!pressing) return;

      if (!dragging) {
        if (Math.hypot(e.clientX - startX, e.clientY - startY) < DRAG_THRESHOLD) return;
        // only now is it a drag
        dragging = true;
        spin = 0;
        stage.classList.add('dragging');
        try {
          stage.setPointerCapture(pointerId);
        } catch {
          /* capture is a nicety; the drag works without it */
        }
      }

      yaw += (e.clientX - lastX) * 0.008;
      pitch += (e.clientY - lastY) * 0.006;
      pitch = Math.max(-1.2, Math.min(1.2, pitch));
      // the frame is fitted to one turn at the current pitch, so tilting has to refit it
      fitViewBox();
      lastX = e.clientX;
      lastY = e.clientY;
      if (!rafId) frame();
    });

    function endDrag() {
      if (dragging) {
        stage.classList.remove('dragging');
        // drift resumes, slower, so it never fights the reader
        if (!still.matches && pinned < 0) spin = 0.0012;
        try {
          stage.releasePointerCapture(pointerId);
        } catch {
          /* nothing to release */
        }
      }
      pressing = false;
      // cleared on the next frame so the click handler can still see it
      requestAnimationFrame(() => {
        dragging = false;
      });
    }
    /**
     * On window, not on the stage. A node's pointerup calls stopPropagation so
     * the stage's release-the-pin handler does not immediately undo the
     * selection — which would also have stopped endDrag from ever running,
     * leaving `pressing` true and the pointer captured. window sees it either
     * way, and also catches a release outside the figure.
     */
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    /* ---- pick ---- */

    function show(i: number) {
      picked = i;
      const n = nodes[i];
      els.forEach((e, j) => e.g.classList.toggle('on', j === i));

      const near = n.nb
        .map((x) => `<span class="cl-nb">${x.term}<i>${x.d.toFixed(2)}</i></span>`)
        .join('');
      const links = n.u
        .map((u) => `<li><a href="/writing/${u.id}">${u.title}</a></li>`)
        .join('');

      // four concepts come only from the publications; "0 essays" would be
      // accurate but reads as an error, so say what it actually is
      const counts = n.d > 0
        ? `${n.d} essay${n.d === 1 ? '' : 's'}${n.p ? ` · ${n.p} papers` : ''}`
        : `${n.p} paper${n.p === 1 ? '' : 's'} only`;

      read.innerHTML =
        `<p class="cl-r-h"><b>${n.t}</b><span class="dim">${counts}</span></p>` +
        `<p class="cl-r-nb">${near}</p>` +
        (links ? `<p class="cl-r-l">Used in</p><ul class="cl-r-u">${links}</ul>` : '');

      read.hidden = false;
      hint.hidden = true;
      frame();
    }

    /** how far the pointer moved during the current press */
    function travelled() {
      return Math.hypot(lastX - startX, lastY - startY);
    }

    function pick(i: number) {
      if (pinned === i) {
        unpin();
        return;
      }
      pinned = i;
      spin = 0;
      show(i);
      els.forEach((el, j) => el.g.classList.toggle('pinned', j === i));
    }

    function unpin() {
      pinned = -1;
      picked = -1;
      els.forEach((e) => e.g.classList.remove('on', 'pinned'));
      read.hidden = true;
      hint.hidden = false;
      hint.textContent = 'Drag to turn · click a word to open it';
      if (!still.matches) spin = 0.0012;
      frame();
    }

    els.forEach((e, i) => {
      // hover only marks the word; the panel is a click, so it never flickers
      // open while you are sweeping across 210 labels
      e.g.addEventListener('pointerenter', () => {
        if (!dragging && pinned < 0) e.g.classList.add('hot');
      });
      e.g.addEventListener('pointerleave', () => e.g.classList.remove('hot'));
      e.g.addEventListener('focus', () => e.g.classList.add('hot'));
      e.g.addEventListener('blur', () => e.g.classList.remove('hot'));
      /**
       * Selection happens on pointerup, not on click.
       *
       * The click path was unreliable: any press that wandered more than the drag
       * threshold set `dragging`, and that flag was cleared on the next animation
       * frame — which lands after click fires, so the handler bailed and nothing
       * opened. Deciding here, from the distance actually travelled, removes the
       * click synthesis, the pointer capture and the flag timing from the
       * equation entirely.
       */
      e.g.addEventListener('pointerup', (ev) => {
        if (travelled() > DRAG_THRESHOLD) return; // that was a drag
        ev.stopPropagation();
        pick(i);
      });

      e.g.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault();
          pick(i);
        }
      });
    });

    // clicking empty space or pressing Escape releases the pin
    // a press on empty space that did not travel releases the pin
    stage.addEventListener('pointerup', () => {
      if (travelled() > DRAG_THRESHOLD) return;
      if (pinned >= 0) unpin();
    });
    window.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && pinned >= 0) unpin();
    });

    stage.addEventListener('pointerleave', () => {
      els.forEach((e) => e.g.classList.remove('hot'));
    });

    // pause the drift when off screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            if (!rafId) loop();
          } else if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
        }
      }).observe(stage);
    } else {
      loop();
    }

    fitViewBox();
    frame();
  }
</script>
