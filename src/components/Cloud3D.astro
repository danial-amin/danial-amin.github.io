---
/**
 * Fig. 1 — the concept space as a rotating 3D point cloud.
 *
 * The academic site carries the full three-pane projector; this is the reduced
 * version of the same idea — the cloud and nothing else. No projection switcher,
 * no colour-by, no left rail. Drag to orbit, scroll-free, hover for a label,
 * click for the pieces that use a concept.
 *
 * Coordinates are a 3-dimensional classical MDS of the same cosine distance
 * matrix (scripts/build-concept-map.mjs), so this is one eigenvector further
 * into the same decomposition rather than a different embedding. Rotation is a
 * plain Y/X matrix applied per frame to 140 points, which is cheap enough to run
 * in SVG and keeps the labels as real text.
 *
 * Four clusters, four inks — black, blue, burgundy, and burgundy over blue.
 */
import map from '../data/concept-map.json';

const { nodes, cloud, docs, academicDocs, dims } = map;

// how many carry a larger label at rest; the rest are still drawn, just quieter
const cutoff = [...nodes].sort((a, b) => b.docs - a.docs)[Math.min(23, nodes.length - 1)]?.docs ?? 0;

const client = nodes.map((n, i) => ({
  t: n.term,
  d: n.docs,
  p: n.papers,
  a: n.academic,
  c: n.cluster,
  r: n.r,
  big: n.docs >= cutoff,
  nb: n.neighbours.slice(0, 4),
  u: n.used.slice(0, 4),
  v: cloud[i],
}));
---

<figure class="cl" data-set>
  <div class="cl-stage" id="clStage">
    <svg viewBox="-168 -104 336 260" id="clSvg" role="img"
      aria-label={`Rotating three-dimensional embedding of ${nodes.length} concepts from ${docs} essays and ${academicDocs} publications.`}>
      <g id="clPts"></g>
    </svg>

    <p class="cl-badge">
      <span>3D · MDS</span>
      <span>{nodes.length} concepts</span>
      <span>{dims} dims</span>
    </p>

    <p class="cl-hint" id="clHint">Drag to turn · click a word to open it</p>
  </div>

  <!-- underneath, so it never covers the thing it describes -->
  <div class="cl-read" id="clRead" hidden></div>

  <figcaption class="cl-cap">
    <strong>Fig. 1</strong> — {nodes.length} concepts from {docs} essays and {academicDocs}
    {' '}publications, placed by co-occurrence in three dimensions. Ringed points also appear in the
    papers. <a href="https://academic.danialamin.com/publications" rel="noopener" target="_blank">The
    full projector is on the academic site ↗</a>
  </figcaption>

  <script type="application/json" id="clData" set:html={JSON.stringify(client)} />
</figure>

<style>
  /* No frame and no fill — the words sit directly on the paper. */
  .cl {
    margin: 0;
  }

  .cl-stage {
    position: relative;
    cursor: grab;
    touch-action: pan-y;
  }

  .cl-stage.dragging {
    cursor: grabbing;
  }

  .cl-stage svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /**
   * These all have to be :global.
   *
   * The nodes are created with createElementNS at runtime, so they never carry
   * the component's scope attribute — and a scoped selector compiles to
   * `.cl-dot[data-astro-cid-x]`, which cannot match them. Every rule in here was
   * dead: the dots fell back to the SVG default of solid black, which is why the
   * cloud looked like one colour, and the labels were never coloured at all.
   */
  .cl-stage :global(.cl-node) {
    cursor: pointer;
  }

  /* a generous invisible target, so a 3px dot is not the thing you must hit */
  .cl-stage :global(.cl-hit) {
    fill: transparent;
    stroke: none;
  }

  .cl-stage :global(.cl-dot) {
    mix-blend-mode: normal;
  }

  .cl-stage :global(.cl-dot.k0) { fill: var(--c0); }
  .cl-stage :global(.cl-dot.k1) { fill: var(--c1); }
  .cl-stage :global(.cl-dot.k2) { fill: var(--c2); }
  .cl-stage :global(.cl-dot.k3) { fill: var(--c3); }
  .cl-stage :global(.cl-dot.k4) { fill: var(--c4); }
  .cl-stage :global(.cl-dot.k5) { fill: var(--c5); }
  .cl-stage :global(.cl-dot.k6) { fill: var(--c6); }
  .cl-stage :global(.cl-dot.k7) { fill: var(--c7); }

  .cl-stage :global(.cl-dot.ac) {
    stroke: var(--ink-k);
    stroke-width: 0.6;
    paint-order: stroke;
  }

  .cl-stage :global(.cl-lab) {
    font-family: var(--type);
    pointer-events: none;
  }

  .cl-stage :global(.cl-lab.k0) { fill: var(--c0); }
  .cl-stage :global(.cl-lab.k1) { fill: var(--c1); }
  .cl-stage :global(.cl-lab.k2) { fill: var(--c2); }
  .cl-stage :global(.cl-lab.k3) { fill: var(--c3); }
  .cl-stage :global(.cl-lab.k4) { fill: var(--c4); }
  .cl-stage :global(.cl-lab.k5) { fill: var(--c5); }
  .cl-stage :global(.cl-lab.k6) { fill: var(--c6); }
  .cl-stage :global(.cl-lab.k7) { fill: var(--c7); }

  .cl-stage :global(.cl-node.hot .cl-lab),
  .cl-stage :global(.cl-node.on .cl-lab) {
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 1.4;
  }

  .cl-stage :global(.cl-node.on .cl-dot),
  .cl-stage :global(.cl-node.pinned .cl-dot) {
    stroke: var(--ink-k);
    stroke-width: 1.2;
    paint-order: stroke;
  }

  .cl-badge,
  .cl-hint {
    position: absolute;
    margin: 0;
    font-family: var(--type);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .cl-badge {
    top: 0.45rem;
    left: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cl-hint {
    bottom: 0.45rem;
    right: 0.6rem;
  }

  /* sits below the cloud rather than over it */
  .cl-read {
    position: static;
    margin: 0.6rem 0 0;
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--ink-k);
    background: var(--paper);
    border: 2px solid var(--ink-k);
    box-shadow: 4px 4px 0 var(--ink-a);
  }

  .cl-read :global(.cl-r-h) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0;
    padding: 0.3rem 0.45rem;
    background: var(--ink-k);
    color: var(--paper);
  }

  .cl-read :global(.cl-r-h b) {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 0.82rem;
  }

  .cl-read :global(.cl-r-h .dim) {
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  /* neighbours as chips with their distance, rather than a run-on line */
  .cl-read :global(.cl-r-nb) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    margin: 0;
    padding: 0.35rem 0.45rem;
    border-bottom: 1.5px dashed var(--ink-hair);
  }

  .cl-read :global(.cl-nb) {
    font-family: var(--type);
    font-size: 0.6rem;
    border: 1.5px solid var(--ink-hair);
    padding: 0.02rem 0.28rem;
    color: var(--ink-soft);
  }

  .cl-read :global(.cl-nb i) {
    font-style: normal;
    margin-left: 0.3em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .cl-read :global(.cl-r-l) {
    margin: 0;
    padding: 0.3rem 0.45rem 0.1rem;
    font-family: var(--type);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-a);
  }

  /* the links are the point of pinning, so they are rows you can hit */
  .cl-read :global(.cl-r-u) {
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
  }

  .cl-read :global(.cl-r-u li) {
    border-top: 1.5px dashed var(--ink-hair);
  }

  .cl-read :global(.cl-r-u a) {
    display: block;
    padding: 0.28rem 0.45rem;
    color: var(--ink-k);
    text-decoration: none;
    line-height: 1.35;
  }

  .cl-read :global(.cl-r-u a::before) {
    content: '→ ';
    color: var(--ink-a);
  }

  .cl-read :global(.cl-r-u a:hover) {
    background: var(--ink-a);
    color: var(--on-a);
  }

  .cl-read :global(.cl-r-u a:hover::before) {
    color: var(--on-a);
  }

  /* the pinned ring is declared with the other node styles, as :global */

  .cl-cap {
    font-family: var(--type);
    font-size: 0.64rem;
    line-height: 1.6;
    color: var(--paper);
    background: var(--ink-k);
    padding: 0.35rem 0.7rem;
  }

  .cl-cap strong,
  .cl-cap a {
    color: var(--paper);
  }

  .cl-cap a:hover {
    background: var(--ink-a);
    color: var(--on-a);
  }
</style>

<script>
  type CN = {
    t: string; d: number; p: number; a: boolean; c: number; r: number; big: boolean;
    nb: { term: string; d: number }[];
    u: { id: string; title: string }[];
    v: [number, number, number];
  };

  const stage = document.getElementById('clStage');
  const raw = document.getElementById('clData');
  const group = document.getElementById('clPts');

  if (stage && raw && group) {
    const nodes = JSON.parse(raw.textContent || '[]') as CN[];
    const read = document.getElementById('clRead')!;
    const hint = document.getElementById('clHint')!;
    const SVGNS = 'http://www.w3.org/2000/svg';
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    // one <g> per concept, built once and repositioned per frame
    const els = nodes.map((n) => {
      const g = document.createElementNS(SVGNS, 'g');
      g.setAttribute('class', 'cl-node');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', `${n.t}, in ${n.d} essays`);

      // invisible, generous, and first so it sits behind the visible marks
      const hit = document.createElementNS(SVGNS, 'circle');
      hit.setAttribute('class', 'cl-hit');

      const c = document.createElementNS(SVGNS, 'circle');
      c.setAttribute('class', `cl-dot k${n.c}${n.a ? ' ac' : ''}`);
      const t = document.createElementNS(SVGNS, 'text');
      t.setAttribute('class', `cl-lab k${n.c}`);
      t.textContent = n.t;

      g.append(hit, c, t);
      group.append(g);
      return { g, c, t, hit };
    });

    let yaw = 0.6;
    let pitch = -0.25;
    let spin = still.matches ? 0 : 0.0022;
    let picked = -1;
    /**
     * Pinned selection. Without it the readout cleared on pointerleave, so its
     * links vanished the moment you moved toward them — they were unreachable
     * rather than broken. Pinning also freezes the drift, so the thing you are
     * reading about stops moving.
     */
    let pinned = -1;

    const SCALE = 118;
    const DEPTH = 2.6; // perspective divisor

    function frame() {
      const cy = Math.cos(yaw);
      const sy = Math.sin(yaw);
      const cp = Math.cos(pitch);
      const sp = Math.sin(pitch);

      // rotate, project, and collect for depth sorting
      const order: { i: number; z: number; x: number; y: number; k: number }[] = [];
      for (let i = 0; i < nodes.length; i++) {
        const [x0, y0, z0] = nodes[i].v;
        const x1 = x0 * cy - z0 * sy;
        const z1 = x0 * sy + z0 * cy;
        const y1 = y0 * cp - z1 * sp;
        const z2 = y0 * sp + z1 * cp;
        const k = DEPTH / (DEPTH + z2); // nearer = larger
        order.push({ i, z: z2, x: x1 * SCALE * k, y: y1 * SCALE * k, k });
      }
      // painter's algorithm: far points first, so near ones sit on top
      order.sort((a, b) => b.z - a.z);

      for (const o of order) {
        const n = nodes[o.i];
        const e = els[o.i];
        e.g.setAttribute('transform', `translate(${o.x.toFixed(2)} ${o.y.toFixed(2)})`);
        const r = n.r * 0.46 * o.k;
        e.c.setAttribute('r', r.toFixed(2));
        // the hit area covers the word as well as the dot
        e.hit.setAttribute('r', Math.max(4.5, r * 2.4).toFixed(2));
        e.c.setAttribute('fill-opacity', (0.62 + o.k * 0.38).toFixed(2));
        /**
         * Every word is drawn. With 140 of them the crowd is managed by depth
         * rather than by hiding: those at the back are smaller and fainter, so
         * the front of the cloud reads and the back becomes texture. The
         * prominent concepts and the selected one are always fully opaque.
         */
        const front = (o.k - 0.72) / 0.5; // roughly 0 at the back, 1 at the front
        const fade = Math.max(0.16, Math.min(1, front));
        const lit = n.big || o.i === picked;
        e.t.setAttribute('x', (r + 2).toFixed(2));
        e.t.setAttribute('y', '1.6');
        e.t.setAttribute('font-size', ((n.big ? 5 : 3.8) * o.k).toFixed(2));
        e.t.setAttribute('opacity', (lit ? Math.max(0.55, fade) : fade * 0.82).toFixed(2));
        // reorder for depth
        group.append(e.g);
      }
    }

    let rafId = 0;
    function loop() {
      if (spin) yaw += spin;
      frame();
      rafId = requestAnimationFrame(loop);
    }

    /* ---- orbit ---- */

    /**
     * Drag has to be distinguished from click, and the pointer must NOT be
     * captured until it is genuinely a drag.
     *
     * The previous version called setPointerCapture on pointerdown, which
     * redirects every following pointer event — and the click generated from
     * them — to the stage. A node's own click handler therefore never fired, so
     * concepts could not be selected and their links were unreachable. Capture
     * now waits for real movement, and a press that never moves is left alone to
     * become a click.
     */
    const DRAG_THRESHOLD = 4;
    let pressing = false;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let lastY = 0;
    let pointerId = -1;

    stage.addEventListener('pointerdown', (e) => {
      pressing = true;
      dragging = false;
      pointerId = e.pointerId;
      startX = lastX = e.clientX;
      startY = lastY = e.clientY;
    });

    stage.addEventListener('pointermove', (e) => {
      if (!pressing) return;

      if (!dragging) {
        if (Math.hypot(e.clientX - startX, e.clientY - startY) < DRAG_THRESHOLD) return;
        // only now is it a drag
        dragging = true;
        spin = 0;
        stage.classList.add('dragging');
        try {
          stage.setPointerCapture(pointerId);
        } catch {
          /* capture is a nicety; the drag works without it */
        }
      }

      yaw += (e.clientX - lastX) * 0.008;
      pitch += (e.clientY - lastY) * 0.006;
      pitch = Math.max(-1.2, Math.min(1.2, pitch));
      lastX = e.clientX;
      lastY = e.clientY;
      if (!rafId) frame();
    });

    function endDrag() {
      if (dragging) {
        stage.classList.remove('dragging');
        // drift resumes, slower, so it never fights the reader
        if (!still.matches && pinned < 0) spin = 0.0012;
        try {
          stage.releasePointerCapture(pointerId);
        } catch {
          /* nothing to release */
        }
      }
      pressing = false;
      // cleared on the next frame so the click handler can still see it
      requestAnimationFrame(() => {
        dragging = false;
      });
    }
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);

    /* ---- pick ---- */

    function show(i: number) {
      picked = i;
      const n = nodes[i];
      els.forEach((e, j) => e.g.classList.toggle('on', j === i));

      const near = n.nb
        .map((x) => `<span class="cl-nb">${x.term}<i>${x.d.toFixed(2)}</i></span>`)
        .join('');
      const links = n.u
        .map((u) => `<li><a href="/writing/${u.id}">${u.title}</a></li>`)
        .join('');

      // four concepts come only from the publications; "0 essays" would be
      // accurate but reads as an error, so say what it actually is
      const counts = n.d > 0
        ? `${n.d} essay${n.d === 1 ? '' : 's'}${n.p ? ` · ${n.p} papers` : ''}`
        : `${n.p} paper${n.p === 1 ? '' : 's'} only`;

      read.innerHTML =
        `<p class="cl-r-h"><b>${n.t}</b><span class="dim">${counts}</span></p>` +
        `<p class="cl-r-nb">${near}</p>` +
        (links ? `<p class="cl-r-l">Used in</p><ul class="cl-r-u">${links}</ul>` : '');

      read.hidden = false;
      hint.hidden = true;
      frame();
    }

    function unpin() {
      pinned = -1;
      picked = -1;
      els.forEach((e) => e.g.classList.remove('on', 'pinned'));
      read.hidden = true;
      hint.hidden = false;
      hint.textContent = 'Drag to turn · click a word to open it';
      if (!still.matches) spin = 0.0012;
      frame();
    }

    els.forEach((e, i) => {
      // hover only marks the word; the panel is a click, so it never flickers
      // open while you are sweeping across 210 labels
      e.g.addEventListener('pointerenter', () => {
        if (!dragging && pinned < 0) e.g.classList.add('hot');
      });
      e.g.addEventListener('pointerleave', () => e.g.classList.remove('hot'));
      e.g.addEventListener('focus', () => e.g.classList.add('hot'));
      e.g.addEventListener('blur', () => e.g.classList.remove('hot'));
      e.g.addEventListener('click', (ev) => {
        ev.stopPropagation();
        if (dragging) return; // finished a drag, not a click
        if (pinned === i) {
          unpin();
          return;
        }
        pinned = i;
        spin = 0;
        show(i);
        els.forEach((el, j) => el.g.classList.toggle('pinned', j === i));
      });
      e.g.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault();
          e.g.dispatchEvent(new Event('click', { bubbles: true }));
        }
      });
    });

    // clicking empty space or pressing Escape releases the pin
    stage.addEventListener('click', () => {
      if (dragging) return;
      if (pinned >= 0) unpin();
    });
    window.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && pinned >= 0) unpin();
    });

    stage.addEventListener('pointerleave', () => {
      els.forEach((e) => e.g.classList.remove('hot'));
    });

    // pause the drift when off screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            if (!rafId) loop();
          } else if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
        }
      }).observe(stage);
    } else {
      loop();
    }

    frame();
  }
</script>
