---
import '../styles/global.css';
import site from '../data/site.json';
import SiteMotion from '../components/SiteMotion.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Eggs from '../components/Eggs.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.tagline } = Astro.props;
const pageTitle =
  title === site.name ? `${site.name} — Agentic AI & GenAI representation` : `${title} · ${site.name}`;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/research', label: 'Research' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#08090a" />
    <link rel="canonical" href={Astro.site ? new URL(path, Astro.site).href : Astro.url.href} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- fonts: preconnect + link, replacing the render-blocking CSS @import -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=IBM+Plex+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600&display=swap"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {Astro.site && <meta property="og:url" content={new URL(path, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      // Dark is the design; light is a courtesy. Only an explicit stored choice
      // leaves dark, so there is no first-paint flash in either direction.
      (function () {
        // `js` gates every reveal animation. Without it the content is simply
        // visible, so a failed/blocked module never leaves a blank page.
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteMotion />

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">{site.name}</a>

        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={`mailto:${site.email}`}>Contact</a>

          <span class="header-tools">
            <button
              class="kbd-hint"
              type="button"
              id="palette-open"
              aria-label="Open command palette"
            >
              <kbd>⌘</kbd><kbd>K</kbd>
            </button>
            <button
              class="icon-btn"
              type="button"
              id="theme-toggle"
              aria-label="Toggle light and dark theme"
              title="Toggle theme"
            >
              <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
                <circle cx="8" cy="8" r="5.3" />
                <path d="M8 2.7a5.3 5.3 0 0 1 0 10.6z" fill="currentColor" stroke="none" />
              </svg>
            </button>
          </span>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.socials.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
          <a href={site.socials.github} rel="noopener noreferrer" target="_blank">GitHub</a>
          <a href={site.socials.scholar} rel="noopener noreferrer" target="_blank">Scholar</a>
          <a href={site.cv}>CV</a>
          <a href={site.academicUrl} rel="noopener noreferrer" target="_blank">Academic</a>
        </div>
        <p class="footer-fine">
          <span>© {new Date().getFullYear()} {site.name} · {site.location}</span>
          <span>{site.newsletterName}, mirrored in full</span>
        </p>
      </footer>
    </div>

    <!-- egg 4: only reachable by scrolling past the footer -->
    <section class="abyss" aria-hidden="true">
      <p class="abyss-note">
        You scrolled past the end. Almost nobody does.<br />
        <em>“The people you design for are not the average of your data.”</em><br />
        That is four years of research compressed badly — the long version is on the academic
        site. But you went further than most, so: thank you.
      </p>
    </section>

    <CommandPalette />
    <Eggs />

    <script>
      // Theme toggle lives in the layout because both the command palette and
      // the eggs dispatch `site:toggle-theme` at it.
      const root = document.documentElement;

      function apply(theme: string) {
        root.setAttribute('data-theme', theme);
        try {
          localStorage.setItem('theme', theme);
        } catch (e) {
          /* private mode: the attribute still applies to this page */
        }
      }

      function toggleTheme() {
        apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }

      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      document.addEventListener('site:toggle-theme', toggleTheme);

      document.getElementById('palette-open')?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('site:open-palette'));
      });
    </script>
  </body>
</html>
