---
import '../styles/global.css';
import site from '../data/site.json';
import Press from '../components/Press.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Eggs from '../components/Eggs.astro';

interface Props {
  title?: string;
  description?: string;
  /** relative canonical override, e.g. a duplicated topic pointing at the fuller form */
  canonicalPath?: string;
  /** absolute canonical — used when the full version of a piece lives on the academic site */
  canonicalUrl?: string;
}

const { title = site.name, description = site.tagline, canonicalPath, canonicalUrl } = Astro.props;
const pageTitle =
  title === site.name ? `${site.name} — Agentic AI & GenAI representation` : `${title} · ${site.name}`;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalHref =
  canonicalUrl ??
  (Astro.site ? new URL(canonicalPath ?? path, Astro.site).href : canonicalPath ?? Astro.url.href);

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/research', label: 'Research' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-stock="cream">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f4efe3" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=Courier+Prime:wght@400;700&display=swap"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {Astro.site && <meta property="og:url" content={new URL(path, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      // `js` gates every reveal. Without it the page is simply printed and
      // readable, so a blocked module never leaves a blank sheet.
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('stock');
          if (stored === 'black' || stored === 'cream') {
            document.documentElement.setAttribute('data-stock', stored);
          }
        } catch (e) {
          /* private mode — cream stays */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Press />

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">{site.name}</a>

        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={`mailto:${site.email}`}>Contact</a>

          <span class="header-tools">
            {/* a press setting, not a light/dark switch — white and fluoro ink
                on black card is a real Riso technique */}
            <button class="stamp-btn" type="button" id="stock-toggle" aria-label="Change paper stock">
              Stock
            </button>
          </span>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.socials.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
          <a href={site.socials.github} rel="noopener noreferrer" target="_blank">GitHub</a>
          <a href={site.socials.scholar} rel="noopener noreferrer" target="_blank">Scholar</a>
          <a href={site.cv}>CV</a>
          <a href={site.academicUrl} rel="noopener noreferrer" target="_blank">Academic</a>
        </div>
        <p class="colophon">
          <span>© {year} {site.name} · {site.location}</span>
          <span>Set in Archivo Black &amp; Courier Prime</span>
          <span>Two inks · printed off-register on purpose</span>
        </p>

        {/* The eggs used to be unadvertised, which meant nobody found them.
            A closed disclosure is the compromise: the page is not spoiled at a
            glance, but they are discoverable rather than secret. */}
        <details class="eggs">
          <summary>Eight things on this site are hidden</summary>
          <ul>
            <li><b>Type <kbd>persona</kbd></b> — opens PEP, the research tool behind the papers.</li>
            <li><b>Type <kbd>council</kbd></b> — three models deliberate, then consolidate. It mirrors what Council of LLMs actually does.</li>
            <li><b>Type <kbd>misprint</kbd></b> — the pink drum slips and the whole run goes out of register. Type it again to fix the press.</li>
            <li><b>Type <kbd>hire</kbd></b> — you can guess.</li>
            <li><b>Press <kbd>⌘K</kbd></b>, <kbd>?</kbd> or <kbd>/</kbd> — a command palette over every page, system and link.</li>
            <li><b>Open DevTools</b> — there is a note in the console for whoever is reading it.</li>
            <li><b>Stop moving for 40 seconds</b> — something quiet happens.</li>
            <li><b>Scroll past this footer</b> — there is a back page.</li>
          </ul>
          <p>
            The blinking caret on the cover is the only clue any of this is here.
            The 3D concept cloud on the homepage can be dragged, too — not hidden,
            just easy to miss.
          </p>
        </details>
      </footer>
    </div>

    <!-- the back page, past the staples -->
    <section class="backpage" aria-hidden="true">
      <p class="backpage-note">
        You went past the last page. Almost nobody does.
        <strong>“The people you design for are not the average of your data.”</strong>
        Four years of research, compressed badly. The long version is on the academic site —
        but you got further than most, so: thank you.
      </p>
    </section>

    <CommandPalette />
    <Eggs />

    <script>
      // Paper stock. The palette and the eggs both dispatch at this.
      const root = document.documentElement;

      function setStock(stock: string) {
        root.setAttribute('data-stock', stock);
        try {
          localStorage.setItem('stock', stock);
        } catch (e) {
          /* private mode — applies for this page only */
        }
      }

      function flipStock() {
        setStock(root.getAttribute('data-stock') === 'black' ? 'cream' : 'black');
      }

      document.getElementById('stock-toggle')?.addEventListener('click', flipStock);
      document.addEventListener('site:toggle-theme', flipStock);
    </script>
  </body>
</html>
