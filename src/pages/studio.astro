---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

/**
 * Titles for the "open a published post" picker.
 *
 * The list itself comes from the GitHub API at request time, because that is
 * the branch's truth and includes a post committed four minutes ago. But asking
 * GitHub for fifty titles would be fifty more requests, and the titles are not
 * privileged — they are printed on /writing. So they are baked in here from the
 * collection, and the picker falls back to the slug for anything published
 * since this build. The list is never wrong; at worst one row reads as a slug.
 */
const titleByPath = Object.fromEntries(
  (await getCollection('writing')).map((p) => [
    // Keyed lower-case, and looked up the same way. Astro lower-cases collection
    // ids, so RAG-works arrives here as rag-works while the GitHub listing
    // returns the real filename — three posts would have missed their title and
    // shown a bare slug in the picker.
    `src/content/writing/${p.id}.md`.toLowerCase(),
    p.data.title,
  ]),
);

/**
 * The writing desk: paste markdown, see it rendered exactly as the site will
 * print it, publish.
 *
 * This page is prerendered and holds nothing privileged — the markup below is a
 * passphrase form and an empty editor. Every operation that matters happens in
 * /api/preview and /api/publish, both of which refuse to answer without the
 * grant cookie, so serving the shell statically costs nothing.
 *
 * Publishing commits the post to src/content/writing/ on GitHub. It becomes a
 * real collection entry, in version control, rendered by /writing/[...slug]
 * like the other fifty — which is why it appears once the deploy that follows
 * the commit has finished, not the instant the button is pressed.
 */
---

<Base
  title="Studio"
  description="Compose and publish a post."
  noindex
>
  <header class="cover">
    <p class="cover-issue">
      <span>Section — Studio</span>
      <span>Paste markdown</span>
      <span>Commits to the repo</span>
    </p>
    <h1 class="cover-name" style="font-size:var(--t-3)">The desk</h1>
    <p class="cover-line">
      Markdown in, essay out. Publishing writes the file into the writing
      collection, so the post is version-controlled and rendered by the same page
      as everything else.
    </p>
  </header>

  <div class="section">
    <div id="studio-gate" class="gate">
      <form id="studio-auth">
        <label for="studio-pass">Passphrase</label>
        <div class="gate-row">
          <input
            id="studio-pass"
            name="passphrase"
            type="password"
            autocomplete="current-password"
            required
          />
          <button class="btn" type="submit" id="studio-unlock"><span>Unlock</span></button>
        </div>
        <p id="studio-auth-error" class="gate-error" hidden aria-live="polite"></p>
        <p class="studio-hint">The desk has its own passphrase — not the one for the cases.</p>
      </form>
    </div>

    <div id="studio" hidden>
      <p id="studio-target" class="tally" aria-live="polite">Checking the repository…</p>

      <form id="studio-form" class="studio">
        {/* Opening a published post. Hidden until the list arrives, so the desk
            looks exactly as it did for anyone composing something new. */}
        <div class="studio-open" id="st-open" hidden>
          <label for="st-open-pick">Open a published post</label>
          <div class="studio-open-row">
            <select id="st-open-pick">
              <option value="">— new post —</option>
            </select>
            <button class="jump" type="button" id="st-open-go">Load</button>
            <button class="jump" type="button" id="st-open-new" hidden>Stop editing</button>
          </div>
          <p class="studio-note" id="st-open-note" hidden></p>
        </div>

        <div class="studio-fields">
          <p class="studio-field studio-field-wide">
            <label for="st-title">Title</label>
            <input id="st-title" name="title" type="text" autocomplete="off" required />
            <span class="studio-error" data-error-for="title" hidden></span>
          </p>

          <p class="studio-field">
            <label for="st-date">Date</label>
            <input id="st-date" name="date" type="date" required />
            <span class="studio-error" data-error-for="date" hidden></span>
          </p>

          <p class="studio-field">
            <label for="st-source">Form</label>
            <select id="st-source" name="source">
              <option value="essay">Essay</option>
              <option value="newsletter">Newsletter</option>
            </select>
          </p>

          <p class="studio-field studio-field-wide">
            <label for="st-slug">Slug <span class="studio-note" id="st-slug-auto">from the title</span></label>
            <input id="st-slug" name="slug" type="text" autocomplete="off" spellcheck="false" />
            <span class="studio-error" data-error-for="slug" hidden></span>
          </p>

          <p class="studio-field studio-field-wide">
            <label for="st-excerpt">
              Excerpt <span class="studio-note">left empty, the opening paragraph is used</span>
            </label>
            <textarea id="st-excerpt" name="excerpt" rows="2"></textarea>
            <span class="studio-error" data-error-for="excerpt" hidden></span>
          </p>

          <p class="studio-field">
            <label for="st-tags">Tags <span class="studio-note">comma separated</span></label>
            <input id="st-tags" name="tags" type="text" autocomplete="off" />
          </p>

          <p class="studio-field">
            <label for="st-linkedin">LinkedIn URL <span class="studio-note">optional</span></label>
            <input id="st-linkedin" name="linkedinUrl" type="url" autocomplete="off" />
            <span class="studio-error" data-error-for="linkedinUrl" hidden></span>
          </p>
        </div>

        <div class="filters studio-tabs" role="group" aria-label="Editor mode">
          <button type="button" data-mode="write" aria-pressed="true">Write</button>
          <button type="button" data-mode="preview" aria-pressed="false">Preview</button>
          <span class="studio-count" id="st-count">0 words</span>
        </div>

        <div id="st-write">
          <label class="studio-sr" for="st-body">Markdown</label>
          <textarea
            id="st-body"
            name="body"
            rows="24"
            spellcheck="false"
            placeholder="Paste markdown here. A whole .md file works — the frontmatter is read into the fields above."
          ></textarea>
          <span class="studio-error" data-error-for="body" hidden></span>
        </div>

        <div id="st-preview" hidden>
          <div class="studio-preview">
            <div class="prose" id="st-preview-body"></div>
          </div>
        </div>

        <div class="studio-bar">
          <button class="btn" type="submit" id="st-publish"><span>Publish</span></button>
          <label class="studio-replace">
            <input type="checkbox" id="st-replace" />
            replace if it exists
          </label>
          <button class="jump" type="button" id="st-copy">Copy the .md file</button>
          <button class="jump" type="button" id="st-clear">Discard draft</button>
          <button class="jump" type="button" id="st-lock">Lock the desk</button>
        </div>

        <p id="st-status" class="studio-status" hidden aria-live="polite"></p>
      </form>
    </div>
  </div>
</Base>

<script define:vars={{ titleByPath }}>
  window.__studioTitles = titleByPath;
</script>

<script>
  type Fields = {
    title: string;
    date: string;
    source: string;
    excerpt: string;
    tags: string[];
    linkedinUrl: string;
    slug: string;
    body: string;
  };

  const gate = document.getElementById('studio-gate')!;
  const studio = document.getElementById('studio')!;
  const authForm = document.getElementById('studio-auth') as HTMLFormElement;
  const pass = document.getElementById('studio-pass') as HTMLInputElement;
  const unlock = document.getElementById('studio-unlock') as HTMLButtonElement;
  const authError = document.getElementById('studio-auth-error')!;
  const target = document.getElementById('studio-target')!;

  const form = document.getElementById('studio-form') as HTMLFormElement;
  const title = document.getElementById('st-title') as HTMLInputElement;
  const date = document.getElementById('st-date') as HTMLInputElement;
  const source = document.getElementById('st-source') as HTMLSelectElement;
  const slug = document.getElementById('st-slug') as HTMLInputElement;
  const slugAuto = document.getElementById('st-slug-auto')!;
  const excerpt = document.getElementById('st-excerpt') as HTMLTextAreaElement;
  const tags = document.getElementById('st-tags') as HTMLInputElement;
  const linkedin = document.getElementById('st-linkedin') as HTMLInputElement;
  const body = document.getElementById('st-body') as HTMLTextAreaElement;

  const count = document.getElementById('st-count')!;
  const publish = document.getElementById('st-publish') as HTMLButtonElement;
  const replace = document.getElementById('st-replace') as HTMLInputElement;
  const copyBtn = document.getElementById('st-copy') as HTMLButtonElement;
  const clearBtn = document.getElementById('st-clear') as HTMLButtonElement;
  const lockBtn = document.getElementById('st-lock') as HTMLButtonElement;
  const status = document.getElementById('st-status')!;

  const openPanel = document.getElementById('st-open')!;
  const openPick = document.getElementById('st-open-pick') as HTMLSelectElement;
  const openGo = document.getElementById('st-open-go') as HTMLButtonElement;
  const openNew = document.getElementById('st-open-new') as HTMLButtonElement;
  const openNote = document.getElementById('st-open-note')!;

  const writePane = document.getElementById('st-write')!;
  const previewPane = document.getElementById('st-preview')!;
  const previewBody = document.getElementById('st-preview-body')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.studio-tabs button');

  /**
   * Today's date, as the author's calendar has it.
   *
   * This used to be computed in the frontmatter — on a prerendered page, so it froze
   * at whatever day the site was last deployed. The field then offered a stale date
   * that looked plausible, and anything published without noticing carried it: the
   * build in front of me was thirteen days behind. It was also built from
   * toISOString(), which is UTC, so a deploy at 01:00 in Helsinki already stamped the
   * previous day.
   *
   * Local date parts, in the browser, at load. `dateTouched` keeps the author's own
   * choice safe from the refresh below.
   */
  const localToday = () => {
    const d = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  };

  let dateTouched = false;

  /** the studio is a tab people leave open; a date typed yesterday should not ship today */
  function refreshDate() {
    if (dateTouched) return;
    date.value = localToday();
  }

  date.addEventListener('input', () => {
    dateTouched = true;
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshDate();
  });

  const DRAFT_KEY = 'studio-draft-v1';
  /** the slug follows the title until it is edited by hand */
  let slugTouched = false;
  /** the last valid composed file, for the copy-out fallback */
  let composed: string | null = null;

  /**
   * The post being edited, as it was on disk when it was opened.
   *
   * Held so the desk can tell the difference between "replace this post" and
   * "write a new one" — which is the same distinction the filename makes, and
   * the one that produced a duplicate when it was left to the author to
   * remember. Null means composing something new.
   */
  type Editing = { path: string; source: string; date: string; slug: string; title: string };
  let editing: Editing | null = null;

  const DIR: Record<string, string> = { essay: 'essays', newsletter: 'newsletter' };

  /** the path the fields would write to right now — the client's copy of filePath() */
  function currentPath() {
    const dir = DIR[source.value] ?? 'essays';
    return `src/content/writing/${dir}/${date.value}-${slug.value}.md`;
  }

  /* ---------- helpers ---------- */

  function fields(): Fields {
    return {
      title: title.value,
      date: date.value,
      source: source.value,
      excerpt: excerpt.value,
      tags: tags.value
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      linkedinUrl: linkedin.value,
      slug: slug.value,
      body: body.value,
    };
  }

  function say(message: string, kind: 'ok' | 'bad' | 'note' = 'note') {
    status.hidden = false;
    status.dataset.kind = kind;
    status.textContent = message;
  }

  /** links have to be built rather than interpolated — the URLs come from JSON */
  function sayWithLinks(message: string, links: { href: string; text: string }[]) {
    status.hidden = false;
    status.dataset.kind = 'ok';
    status.textContent = `${message} `;
    links.forEach((link, i) => {
      if (i > 0) status.append(' · ');
      const a = document.createElement('a');
      a.className = 'jump';
      a.href = link.href;
      a.textContent = link.text;
      if (link.href.startsWith('http')) {
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      }
      status.append(a);
    });
  }

  function showErrors(errors: Record<string, string>) {
    document.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
      const message = errors[el.dataset.errorFor ?? ''];
      el.textContent = message ?? '';
      el.hidden = !message;
    });
  }

  function slugify(input: string) {
    return input
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/['\u2019`]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 72)
      .replace(/-+$/g, '');
  }

  function syncSlug() {
    if (slugTouched) return;
    slug.value = slugify(title.value);
    slugAuto.hidden = false;
  }

  function updateCount() {
    const words = body.value.trim().split(/\s+/).filter(Boolean).length;
    count.textContent = `${words.toLocaleString('en-GB')} word${words === 1 ? '' : 's'}`;
  }

  /* ---------- draft ---------- */

  // Two thousand words should survive a reload. The draft is local to this
  // browser and is cleared once the post is committed.
  function saveDraft() {
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({ ...fields(), slugTouched, editing }));
    } catch {
      /* private mode — the draft simply isn't kept */
    }
  }

  function loadDraft() {
    try {
      const stored = localStorage.getItem(DRAFT_KEY);
      if (!stored) return;
      const draft = JSON.parse(stored) as Fields & { slugTouched?: boolean; editing?: Editing | null };
      title.value = draft.title ?? '';
      if (draft.date) {
        date.value = draft.date;
        dateTouched = true;
      }
      if (draft.source) source.value = draft.source;
      excerpt.value = draft.excerpt ?? '';
      tags.value = (draft.tags ?? []).join(', ');
      linkedin.value = draft.linkedinUrl ?? '';
      slug.value = draft.slug ?? '';
      body.value = draft.body ?? '';
      slugTouched = Boolean(draft.slugTouched);
      slugAuto.hidden = slugTouched;
      // an interrupted edit resumes as an edit; otherwise a reload would turn it
      // back into a new post and the next publish would duplicate it
      editing = draft.editing ?? null;
      if (editing) {
        replace.checked = true;
        dateTouched = true;
        slugTouched = true;
        slugAuto.hidden = true;
      }
      reflectEditing();
      updateCount();
      if (draft.body) {
        say(editing ? `Draft restored — still editing ${editing.path}.` : 'Draft restored from this browser.', 'note');
      }
    } catch {
      /* an unreadable draft is not worth blocking the editor for */
    }
  }

  /* ---------- opening a published post ---------- */

  const titles: Record<string, string> = (window as any).__studioTitles ?? {};

  type Row = { path: string; source: string; date: string; slug: string };

  /** "20 Aug 2026 · The Benchmarkolypse…" — the date first, because that is what
   *  distinguishes two posts on the same subject */
  function rowLabel(row: Row) {
    const [y, m, d] = row.date.split('-').map(Number);
    const when = new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', {
      timeZone: 'UTC',
      year: 'numeric',
      month: 'short',
      day: '2-digit',
    });
    return `${when} · ${titles[row.path.toLowerCase()] ?? row.slug}`;
  }

  async function loadPostList() {
    let rows: Row[];
    try {
      const res = await fetch('/api/posts', { headers: { accept: 'application/json' } });
      if (!res.ok) return; // the desk still composes; opening is the extra
      const data = (await res.json()) as { posts?: Row[] };
      rows = data.posts ?? [];
    } catch {
      return;
    }
    if (!rows.length) return;

    openPick.textContent = '';
    const blank = document.createElement('option');
    blank.value = '';
    blank.textContent = '— new post —';
    openPick.append(blank);

    for (const [value, label] of [
      ['essay', 'Essays'],
      ['newsletter', 'Newsletter'],
    ]) {
      const group = rows.filter((r) => r.source === value);
      if (!group.length) continue;
      const optgroup = document.createElement('optgroup');
      optgroup.label = `${label} (${group.length})`;
      for (const row of group) {
        const option = document.createElement('option');
        option.value = row.path;
        option.textContent = rowLabel(row);
        optgroup.append(option);
      }
      openPick.append(optgroup);
    }

    openPanel.hidden = false;
    if (editing) openPick.value = editing.path;
  }

  /**
   * The path this publish will replace, or null for a new post.
   *
   * Sent to the server as `editPath`, which makes the filename explicit instead
   * of recomposed — the only way to replace the seven posts whose names predate
   * the slug rule, since validate() would slugify `personality_ai` into
   * `personality-ai` and write a second file.
   *
   * Null the moment the fields no longer describe the open post: at that point
   * the author is writing a new post, and saying otherwise would pin the
   * filename to a date the frontmatter no longer carries.
   */
  function pinnedPath() {
    return editing && currentPath() === editing.path ? editing.path : null;
  }

  function reflectEditing() {
    openNew.hidden = !editing;
    if (!editing) {
      openNote.hidden = true;
      return;
    }
    const now = currentPath();
    openNote.hidden = false;
    if (now === editing.path) {
      openNote.dataset.kind = 'ok';
      openNote.textContent = `Editing ${editing.path} — publishing replaces it in place.`;
    } else {
      /**
       * The identity moved. This is the duplicate, caught before it is made:
       * the date or the slug or the form has changed, so publishing would write
       * a second file and leave the first one live at its own URL.
       */
      openNote.dataset.kind = 'bad';
      openNote.textContent =
        `The date, slug or form has changed. Publishing now writes a NEW post at ${now} ` +
        `and leaves ${editing.path} where it is. Put them back to edit in place, or press ` +
        `“Stop editing” if a new post is what you want.`;
      /**
       * Replace was ticked when the post was opened, and it no longer points at
       * the post it was ticked for. Left ticked, one click would overwrite
       * whatever happens to sit at the new path — a different post, if the new
       * date and slug collide with one. Untick it and let the 409 ask.
       */
      replace.checked = false;
    }
  }

  async function openPost(path: string) {
    const dirty = body.value.trim().length > 0 || title.value.trim().length > 0;
    if (dirty && !editing && !confirm('Replace what is in the editor with that post?')) return;
    if (dirty && editing && editing.path !== path &&
        !confirm('Discard the edits to the open post and load that one instead?')) return;

    openGo.disabled = true;
    say('Opening…', 'note');
    try {
      const res = await fetch(`/api/posts?path=${encodeURIComponent(path)}`, {
        headers: { accept: 'application/json' },
      });
      const data = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        message?: string;
        path?: string;
        fields?: Fields;
        frontmatterDate?: string;
      };
      if (!res.ok || !data.ok || !data.fields) {
        say(data.message ?? 'That post could not be opened.', 'bad');
        return;
      }

      const f = data.fields;
      title.value = f.title ?? '';
      date.value = f.date ?? '';
      source.value = f.source ?? 'essay';
      excerpt.value = f.excerpt ?? '';
      tags.value = (f.tags ?? []).join(', ');
      linkedin.value = f.linkedinUrl ?? '';
      slug.value = f.slug ?? '';
      body.value = f.body ?? '';

      /**
       * Both latches go down, and this is the whole point of the feature.
       *
       * The date field refreshes itself to today until it is touched, and the
       * slug follows the title until it is typed in. Filling them in code fires
       * neither event, so without these two lines opening a post from August and
       * switching tabs would quietly stamp it today, and fixing a typo in the
       * title would move its URL.
       */
      dateTouched = true;
      slugTouched = true;
      slugAuto.hidden = true;

      editing = {
        path: data.path ?? path,
        source: source.value,
        date: date.value,
        slug: slug.value,
        title: title.value,
      };
      replace.checked = true;
      openPick.value = editing.path;

      updateCount();
      showErrors({});
      saveDraft();
      reflectEditing();

      const drift =
        data.frontmatterDate && data.frontmatterDate !== f.date
          ? ` Its frontmatter says ${data.frontmatterDate}; the filename wins, so the date shown is ${f.date}.`
          : '';
      say(`Opened ${editing.path}. Publishing replaces it.${drift}`, 'ok');
    } catch {
      say('The request failed. Nothing was opened.', 'bad');
    } finally {
      openGo.disabled = false;
    }
  }

  function stopEditing() {
    editing = null;
    replace.checked = false;
    openPick.value = '';
    reflectEditing();
    saveDraft();
  }

  openGo.addEventListener('click', () => {
    const path = openPick.value;
    if (!path) {
      stopEditing();
      say('Composing a new post.', 'note');
      return;
    }
    void openPost(path);
  });

  openNew.addEventListener('click', () => {
    stopEditing();
    say('No longer editing. Publishing will write a new post.', 'note');
  });

  /* ---------- gate ---------- */

  async function checkConfig() {
    let res: Response;
    try {
      res = await fetch('/api/publish', { headers: { accept: 'application/json' } });
    } catch {
      authError.textContent = 'The server did not answer. Reload once it is back.';
      authError.hidden = false;
      return;
    }
    const data = await res.json().catch(() => ({}) as Record<string, unknown>);

    if (res.status === 503) {
      authError.textContent =
        'No studio passphrase is configured on the server, so the desk cannot be opened. Set PUBLISH_PASSPHRASE.';
      authError.hidden = false;
      return;
    }
    if (!res.ok) return; // 401: stay on the gate

    gate.hidden = true;
    studio.hidden = false;

    if (data.ready) {
      target.textContent = `Commits to ${data.repo} on ${data.branch} · live after the rebuild`;
    } else {
      target.textContent = String(
        data.message ?? 'Publishing is not configured on the server.',
      );
      target.dataset.kind = 'bad';
      publish.disabled = true;
      say(
        'Publishing is off, but Preview and “Copy the .md file” still work — paste the file into the repo by hand.',
        'note',
      );
    }

    refreshDate();
    loadDraft();
    if (data.ready) void loadPostList();
    title.focus();
  }

  authForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    authError.hidden = true;
    unlock.disabled = true;
    try {
      const res = await fetch('/api/studio-auth', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ passphrase: pass.value }),
      });
      const data = (await res.json().catch(() => ({}))) as { retryInSeconds?: number };

      if (res.ok) {
        pass.value = '';
        await checkConfig();
        return;
      }
      authError.textContent =
        res.status === 429
          ? `Too many attempts. Try again in ${Math.ceil((data.retryInSeconds ?? 1200) / 60)} minutes.`
          : res.status === 503
            ? 'No studio passphrase is configured on the server. Set PUBLISH_PASSPHRASE.'
            : 'That passphrase is not right.';
      authError.hidden = false;
    } catch {
      authError.textContent = 'The request failed. Check the connection and try again.';
      authError.hidden = false;
    } finally {
      unlock.disabled = false;
    }
  });

  /* ---------- paste of a whole file ---------- */

  body.addEventListener('paste', (event) => {
    const text = event.clipboardData?.getData('text/plain') ?? '';
    if (!/^\s*---\r?\n/.test(text)) return; // an ordinary paste, leave it alone

    event.preventDefault();
    void adoptFile(text);
  });

  /**
   * A pasted .md file is split by the server, using the same parser the
   * collection's own files were written with, and the frontmatter lands in the
   * fields instead of being rendered as a stray table.
   */
  async function adoptFile(text: string) {
    try {
      const res = await fetch('/api/preview', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      if (!res.ok) throw new Error('split failed');
      const data = (await res.json()) as {
        found: boolean;
        body: string;
        fields: Partial<Fields>;
      };

      body.value = data.body;
      const f = data.fields;
      if (f.title) title.value = f.title;
      if (f.date) {
        date.value = f.date;
        // Without this the refresh-on-tab-focus below would overwrite a pasted
        // file's own date with today's, which is how a post gets published twice
        // at two URLs. Setting .value in code fires no input event, so the latch
        // has to be set by hand.
        dateTouched = true;
      }
      if (f.source) source.value = f.source;
      if (f.excerpt) excerpt.value = f.excerpt;
      if (f.tags?.length) tags.value = f.tags.join(', ');
      if (f.linkedinUrl) linkedin.value = f.linkedinUrl;
      syncSlug();
      updateCount();
      saveDraft();
      reflectEditing();
      say(
        data.found
          ? 'Frontmatter read into the fields. Check the date and the slug.'
          : 'Pasted.',
        'note',
      );
    } catch {
      // the paste must not be lost because a round trip failed
      body.value = text;
      updateCount();
      saveDraft();
      say('Pasted as-is — the frontmatter could not be read. Fill the fields by hand.', 'bad');
    }
  }

  /* ---------- preview ---------- */

  async function renderPreview() {
    previewBody.textContent = 'Rendering…';
    try {
      const res = await fetch('/api/preview', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(fields()),
      });
      const data = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        html?: string;
        file?: string | null;
        path?: string | null;
        errors?: Record<string, string>;
        message?: string;
      };

      if (!res.ok || !data.ok) {
        previewBody.textContent = data.message ?? 'The preview could not be rendered.';
        return;
      }

      // The author's own markdown, rendered by the site's own processor. Raw
      // HTML in a post is legitimate and is passed through here as the real page
      // would pass it through.
      previewBody.innerHTML = data.html ?? '';
      composed = data.file ?? null;
      showErrors(data.errors ?? {});
      if (data.path) target.dataset.path = data.path;
    } catch {
      previewBody.textContent = 'The preview request failed.';
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const preview = tab.dataset.mode === 'preview';
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      writePane.hidden = preview;
      previewPane.hidden = !preview;
      if (preview) void renderPreview();
    });
  });

  /* ---------- publish ---------- */

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    showErrors({});
    publish.disabled = true;
    say('Committing…', 'note');

    try {
      const res = await fetch('/api/publish', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          ...fields(),
          overwrite: replace.checked,
          ...(pinnedPath() ? { editPath: pinnedPath() } : {}),
        }),
      });
      const data = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        reason?: string;
        message?: string;
        errors?: Record<string, string>;
        url?: string;
        path?: string;
        replaced?: boolean;
        retryInSeconds?: number;
        commit?: { sha: string; url: string };
      };

      if (res.ok && data.ok) {
        try {
          localStorage.removeItem(DRAFT_KEY);
        } catch {
          /* nothing to clear */
        }
        /**
         * A post just published is a post that can be edited, so the picker has
         * to know about it — and the desk stays on it rather than silently
         * becoming "new post" again, which is what made the second publish of an
         * edited draft write a duplicate.
         */
        if (data.path) {
          editing = {
            path: data.path,
            source: source.value,
            date: date.value,
            slug: slug.value,
            title: title.value,
          };
          replace.checked = true;
          reflectEditing();
        }
        void loadPostList();

        sayWithLinks(
          `${data.replaced ? 'Replaced' : 'Committed'} ${data.path} as ${data.commit?.sha}. It goes live at the URL below once the deploy finishes — usually a couple of minutes.`,
          [
            { href: data.url ?? '/writing', text: data.url ?? '/writing' },
            ...(data.commit?.url ? [{ href: data.commit.url, text: 'the commit ↗' }] : []),
          ],
        );
        return;
      }

      if (res.status === 422 && data.errors) {
        showErrors(data.errors);
        say('The post is not publishable yet — see the fields above.', 'bad');
      } else if (res.status === 409 && data.reason === 'gone') {
        // the branch moved under an open desk; committing would resurrect it
        say(data.message ?? 'The post being edited is no longer there.', 'bad');
      } else if (res.status === 409) {
        replace.checked = false;
        say(
          `${data.message ?? 'That path is taken.'} Tick “replace if it exists” to overwrite ${data.path ?? 'it'}.`,
          'bad',
        );
      } else if (res.status === 401) {
        studio.hidden = true;
        gate.hidden = false;
        say('The session expired. Unlock again — your draft is kept.', 'bad');
      } else if (res.status === 429) {
        say(`Too many attempts. Try again in ${data.retryInSeconds ?? 300} seconds.`, 'bad');
      } else {
        say(data.message ?? 'Publishing failed.', 'bad');
      }
    } catch {
      say('The request failed. Nothing was committed.', 'bad');
    } finally {
      publish.disabled = false;
    }
  });

  /* ---------- small actions ---------- */

  copyBtn.addEventListener('click', async () => {
    if (!composed) {
      await renderPreview(); // composing the file is a side effect of validating it
      if (!composed) {
        say('The file cannot be composed until the fields validate.', 'bad');
        return;
      }
    }
    try {
      await navigator.clipboard.writeText(composed);
      say('The complete .md file is on the clipboard.', 'ok');
    } catch {
      say('The clipboard was refused. Use Preview and copy from there.', 'bad');
    }
  });

  clearBtn.addEventListener('click', () => {
    if (!confirm('Discard this draft? It is not recoverable.')) return;
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {
      /* nothing to clear */
    }
    form.reset();
    slugTouched = false;
    composed = null;
    stopEditing();
    updateCount();
    showErrors({});
    say('Draft discarded.', 'note');
  });

  lockBtn.addEventListener('click', async () => {
    // The draft stays in this browser; only the grant is given up.
    await fetch('/api/studio-auth', { method: 'DELETE' }).catch(() => undefined);
    studio.hidden = true;
    gate.hidden = false;
    say('The desk is locked. The draft is still here.', 'note');
  });

  slug.addEventListener('input', () => {
    slugTouched = slug.value.trim().length > 0;
    slugAuto.hidden = slugTouched;
    reflectEditing();
  });

  title.addEventListener('input', () => {
    syncSlug();
    // the title moves the slug, and the slug is half the identity
    reflectEditing();
  });
  date.addEventListener('input', reflectEditing);
  source.addEventListener('change', reflectEditing);
  body.addEventListener('input', updateCount);

  let saveTimer = 0;
  form.addEventListener('input', () => {
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(saveDraft, 600);
  });

  // ⌘S / Ctrl-S is muscle memory in an editor; here it saves the draft rather
  // than letting the browser offer to save the page.
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's' && !studio.hidden) {
      event.preventDefault();
      saveDraft();
      say('Draft saved in this browser.', 'note');
    }
  });

  void checkConfig();
</script>
