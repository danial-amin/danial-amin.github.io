---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title={site.name} description={site.tagline} page="home">
  <div class="home-portal">
    <p class="home-kicker">Espoo</p>
    <h1 class="home-name">{site.name}</h1>
    <p class="home-line">{site.tagline}</p>

    <nav class="home-doors" aria-label="Sections">
      <a class="door" href="/work">
        <span class="door-num">01</span>
        <span class="door-title">Work</span>
        <span class="door-desc">Live systems & case studies — why they exist, what shipped.</span>
      </a>
      <a class="door" href="/writing">
        <span class="door-num">02</span>
        <span class="door-title">Writing</span>
        <span class="door-desc">Essays and full mirrors of AI Pulse & Data Waves.</span>
      </a>
      <a class="door" href="/research">
        <span class="door-num">03</span>
        <span class="door-title">Research</span>
        <span class="door-desc">GenAI personas, fairness, HCI — plus the academic site.</span>
      </a>
    </nav>

    <p class="home-contact">
      <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
      <a href={site.cv}>CV</a>
    </p>
  </div>
</Base>
