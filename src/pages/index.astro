---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Ink from '../components/Ink.astro';
import Cloud3D from '../components/Cloud3D.astro';
import SystemsList from '../components/SystemsList.astro';
import WorkIndex from '../components/WorkIndex.astro';
import WritingList from '../components/WritingList.astro';
import ResearchTeaser from '../components/ResearchTeaser.astro';
import QuoteStrip from '../components/QuoteStrip.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getWriting, fullVersionOf } from '../lib/writing';
import site from '../data/site.json';

const { items: recent, all, alternatesFor } = await getWriting();
const essayPosts = all.filter((p) => p.data.source === 'essay');
const essays = essayPosts.length;
const newsletters = all.filter((p) => p.data.source === 'newsletter').length;

/**
 * How many of the essays are extracts rather than the whole piece.
 *
 * The note under this section used to say all of it was "mirrored in full". The
 * newsletter is; the essays are not — 27 of them run here at about 300 words
 * against 48,622 on the academic site, and the piece pages say so in their own
 * footer. Counted rather than written down, so it cannot go stale when an essay
 * gains or loses its long version.
 */
const extracts = essayPosts.filter((p) => fullVersionOf(p)).length;
const nameParts = site.name.split(' ');
---

<Base title={site.name} description={site.tagline}>
  <header class="cover">
    <p class="cover-issue">
      <span>Espoo, Finland</span>
      <span>Practice &amp; research</span>
      <span>Two inks, off register</span>
      {/* the one clue that this page listens for typing */}
      <span class="caret" aria-hidden="true"></span>
    </p>

    <h1 class="cover-name">
      {nameParts.map((part, i) => (
        <Ink text={part} x={3 + i} y={5} fromX={22 - i * 6} fromY={26} />
      ))}
    </h1>

    <div class="cover-body">
      <div>
        <p class="cover-line" data-set style="--set-delay:220ms">{site.tagline}</p>
        <div class="cover-actions" data-set style="--set-delay:300ms">
          <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
          <a class="btn btn-out" href="#systems">See what runs</a>
        </div>
      </div>
      {/* Fig. 1 — the cloud only; the full projector lives on the academic site */}
      <Cloud3D />
    </div>
  </header>

  <Section plate num="1" title="Products I run" note="Five in production. Each one exists because something annoyed me enough to build the fix." id="systems">
    <SystemsList plates={false} />
  </Section>

  <Section plate num="2" title="Work that shipped" note="Consulting and product engagements, described by outcome." id="work">
    <WorkIndex plates={false} />
  </Section>

  <Section plate num="3" title="Writing" note={`${essays} essays and ${newsletters} issues of ${site.newsletterName}, mirrored in full — bar ${extracts} essays that run here as extracts, complete on the academic site.`} id="writing">
    <WritingList posts={recent} alternatesFor={alternatesFor} limit={6} showMore plates={false} />
  </Section>

  <Section plate num="4" title="Research" note="Doctoral work at Vaasa on how GenAI represents the people it claims to serve." id="research">
    <ResearchTeaser />
  </Section>

  <Section plate num="5" title="What others say" id="proof">
    <QuoteStrip />
  </Section>

  <Section plate num="6" title="Build something clear" id="contact">
    <ContactBlock />
  </Section>
</Base>
