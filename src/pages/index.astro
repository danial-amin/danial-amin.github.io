---
import Base from '../layouts/Base.astro';
import SystemsList from '../components/SystemsList.astro';
import WorkIndex from '../components/WorkIndex.astro';
import LockedCases from '../components/LockedCases.astro';
import WritingList from '../components/WritingList.astro';
import ResearchTeaser from '../components/ResearchTeaser.astro';
import QuoteStrip from '../components/QuoteStrip.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const posts = await getCollection('writing');
const newsletters = posts.filter((p) => p.data.source === 'newsletter');
---

<Base title={site.name} description={site.tagline}>
  <header class="hero">
    <div>
      <p class="hero-kicker">Espoo · practice · research</p>
      <h1 class="hero-display">{site.name}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-meta">
        <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
        <a href="/work">Work</a>
        <a href="/writing">Writing</a>
      </div>
    </div>
    <aside class="hero-aside orbit" aria-label="At a glance">
      <span>Case studies from consulting & product work</span>
      <span>Live systems — with the reasoning behind each</span>
      <span>{site.newsletterName}, mirrored in full</span>
      <span>GenAI personas & HCI research</span>
    </aside>
  </header>

  <WorkIndex />
  <SystemsList />
  <LockedCases />
  <WritingList posts={newsletters} limit={5} />
  <ResearchTeaser />
  <QuoteStrip />
  <ContactBlock />
</Base>
