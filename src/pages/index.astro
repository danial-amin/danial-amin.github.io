---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Ink from '../components/Ink.astro';
import Cloud3D from '../components/Cloud3D.astro';
import SystemsList from '../components/SystemsList.astro';
import WorkIndex from '../components/WorkIndex.astro';
import WritingList from '../components/WritingList.astro';
import ResearchTeaser from '../components/ResearchTeaser.astro';
import QuoteStrip from '../components/QuoteStrip.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getWriting, fullVersionOf } from '../lib/writing';
import site from '../data/site.json';

const { items: recent, all, alternatesFor } = await getWriting();
const essayPosts = all.filter((p) => p.data.source === 'essay');
const essays = essayPosts.length;
const newsletters = all.filter((p) => p.data.source === 'newsletter').length;

/** Count essays shown here as extracts, not as full-length posts. */
const extracts = essayPosts.filter((p) => fullVersionOf(p)).length;
const nameParts = site.name.split(' ');
---

<Base title={site.name} description={site.tagline}>
  <header class="cover">
    <p class="cover-issue">
      <span>Espoo, Finland</span>
      <span>Products &amp; research</span>
      <span>Two inks, off register</span>
      <span class="caret" aria-hidden="true"></span>
    </p>

    <h1 class="cover-name">
      {nameParts.map((part, i) => (
        <Ink text={part} x={3 + i} y={5} fromX={22 - i * 6} fromY={26} />
      ))}
    </h1>

    <div class="cover-body">
      <div>
        <p class="cover-line" data-set style="--set-delay:220ms">{site.tagline}</p>
        <div class="cover-actions" data-set style="--set-delay:300ms">
          <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
          <a class="btn btn-out" href="#systems">See my projects</a>
        </div>
      </div>
      <Cloud3D />
    </div>
  </header>

  <Section plate num="1" title="Products I run" note="Tools I built and maintain, and what each one does." id="systems">
    <SystemsList plates={false} />
  </Section>

  <Section plate num="2" title="Selected work" note="Client and product projects I can discuss publicly." id="work">
    <WorkIndex plates={false} />
  </Section>

  <Section plate num="3" title="Writing" note={`${essays} essays and ${newsletters} issues of ${site.newsletterName}. ${extracts} essays are extracts; their full versions are on my academic site.`} id="writing">
    <WritingList posts={recent} alternatesFor={alternatesFor} limit={6} showMore plates={false} />
  </Section>

  <Section plate num="4" title="Research" note="My research at the University of Vaasa examines how AI-generated personas represent people." id="research">
    <ResearchTeaser />
  </Section>

  <Section plate num="5" title="What others say" id="proof">
    <QuoteStrip />
  </Section>

  <Section plate num="6" title="Get in touch" id="contact">
    <ContactBlock />
  </Section>
</Base>
