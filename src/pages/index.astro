---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Ink from '../components/Ink.astro';
import Cloud3D from '../components/Cloud3D.astro';
import SystemsList from '../components/SystemsList.astro';
import WorkIndex from '../components/WorkIndex.astro';
import WritingList from '../components/WritingList.astro';
import ResearchTeaser from '../components/ResearchTeaser.astro';
import QuoteStrip from '../components/QuoteStrip.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getWriting } from '../lib/writing';
import site from '../data/site.json';

const { items: recent, all, alternatesFor } = await getWriting();
const essays = all.filter((p) => p.data.source === 'essay').length;
const newsletters = all.filter((p) => p.data.source === 'newsletter').length;
const nameParts = site.name.split(' ');
---

<Base title={site.name} description={site.tagline}>
  <header class="cover">
    <p class="cover-issue">
      <span>Espoo, Finland</span>
      <span>Practice &amp; research</span>
      <span>Two inks, off register</span>
    </p>

    <h1 class="cover-name">
      {nameParts.map((part, i) => (
        <Ink text={part} x={3 + i} y={5} fromX={22 - i * 6} fromY={26} />
      ))}
    </h1>

    <div class="cover-body">
      <div>
        <p class="cover-line" data-set style="--set-delay:220ms">{site.tagline}</p>
        <div class="cover-actions" data-set style="--set-delay:300ms">
          <a class="btn" href={`mailto:${site.email}`}>{site.cta}</a>
          <a class="btn btn-out" href="#systems">See what runs</a>
        </div>
      </div>
      {/* Fig. 1 — the cloud only; the full projector lives on the academic site */}
      <Cloud3D />
    </div>
  </header>

  <Section num="1" title="Products I run" note="Five in production. Each one exists because something annoyed me enough to build the fix." id="systems">
    <SystemsList />
  </Section>

  <Section num="2" title="Work that shipped" note="Consulting and product engagements, described by outcome." id="work">
    <WorkIndex />
  </Section>

  <Section num="3" title="Writing" note={`${essays} essays and ${newsletters} issues of ${site.newsletterName}, mirrored in full.`} id="writing">
    <WritingList posts={recent} alternatesFor={alternatesFor} limit={6} showMore />
  </Section>

  <Section num="4" title="Research" note="Doctoral work at Vaasa on how GenAI represents the people it claims to serve." id="research">
    <ResearchTeaser />
  </Section>

  <Section num="5" title="Collaborators" id="proof">
    <QuoteStrip />
  </Section>

  <Section num="6" title="Build something clear" id="contact">
    <ContactBlock />
  </Section>
</Base>
