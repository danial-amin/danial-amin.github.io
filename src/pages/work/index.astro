---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Ink from '../../components/Ink.astro';
import SystemsList from '../../components/SystemsList.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import LockedCases from '../../components/LockedCases.astro';
import systems from '../../data/systems.json';
import projects from '../../data/projects.json';
---

<Base title="Work" description="Tools I maintain and selected client and product projects.">
  <header class="cover">
    <p class="cover-issue">
      <span>Section — Work</span>
      <span>{systems.length} live systems</span>
      <span>{projects.length} open cases</span>
      <span>Some client work is private</span>
    </p>
    <h1 class="cover-name" style="font-size:var(--t-4)">
      <Ink text="Systems" y={4} fromY={20} />
      <Ink text="& cases" x={5} y={5} fromX={20} fromY={24} />
    </h1>
    <p class="cover-line" data-set style="--set-delay:220ms">
      Tools I maintain, projects I can discuss publicly, and client work I keep private.
    </p>
  </header>

  <Section num="1" title="Products I run" note="What each tool does and why I built it." id="systems">
    <SystemsList />
  </Section>

  <Section num="2" title="Engagements" note="Selected client and product projects." id="cases">
    <WorkIndex featuredOnly={false} showMore={false} />
  </Section>

  <Section num="—" title="Held back" note="Some client work is available by passphrase only." id="locked">
    <LockedCases />
  </Section>
</Base>
