---
import Base from '../../layouts/Base.astro';
import SystemsList from '../../components/SystemsList.astro';
import LockedCases from '../../components/LockedCases.astro';
import projects from '../../data/projects.json';
---

<Base title="Work" description="Case studies and live systems" page="work">
  <header class="page-intro page-intro-work">
    <p class="page-eyebrow">Work</p>
    <h1 class="page-h1">Systems & cases</h1>
    <p class="page-deck">
      Products I still run, with the reasoning behind them. Then open engagements. Confidential work is locked below.
    </p>
  </header>

  <SystemsList />

  <section class="section">
    <p class="section-label">Case studies</p>
    <h2 class="section-title" data-num="Open">Engagements</h2>
    <ul class="index-list work-cases">
      {
        projects
          .filter((p) => !p.locked)
          .map((p) => (
            <li>
              <div class="index-row">
                <span class="index-title">{p.title}</span>
                <span class="index-meta">{p.year}</span>
                <p class="index-blurb">{p.outcome}</p>
              </div>
            </li>
          ))
      }
    </ul>
  </section>

  <LockedCases />
</Base>
