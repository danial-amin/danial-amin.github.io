---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function fmt(d: Date) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={post.data.title} description={post.data.excerpt}>
  <article class:list={['prose', post.data.source === 'newsletter' && 'newsletter-prose']}>
    <p class="section-label">
      {post.data.source === 'newsletter' ? 'AI Pulse & Data Waves' : 'Essay'}
    </p>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {fmt(post.data.date)}
      {
        post.data.linkedinUrl && (
          <>
            {' '}
            ·{' '}
            <a href={post.data.linkedinUrl} rel="noopener noreferrer" target="_blank">
              View on LinkedIn
            </a>
          </>
        )
      }
    </p>
    <Content />
    <p style="margin-top:2.5rem">
      <a href="/writing" style="font-family:var(--mono);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em">
        ← All writing
      </a>
    </p>
  </article>
</Base>
