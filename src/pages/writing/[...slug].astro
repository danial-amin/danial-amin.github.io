---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getWriting, fullVersionOf, type Post } from '../../lib/writing';
import site from '../../data/site.json';

export async function getStaticPaths() {
  // Every post keeps its own URL, including alternates, so nothing 404s and
  // links already shared on LinkedIn keep resolving.
  const { all } = await getWriting();
  return all.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { canonicalFor, alternatesFor } = await getWriting();

const canonical = canonicalFor.get(post.id) ?? post;
const isCanonical = canonical.id === post.id;
const alternates = alternatesFor.get(post.id) ?? [];

const { Content } = await render(post);
const isNewsletter = post.data.source === 'newsletter';
/** masthead label, e.g. "AI Pulse & Data Waves" */
const label = (p: Post) => (p.data.source === 'newsletter' ? site.newsletterName : 'Essay');
/** lowercase form that reads correctly inside a sentence */
const inline = (p: Post) => (p.data.source === 'newsletter' ? 'newsletter' : 'essay');

function fmt(d: Date) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Point search engines at the fuller version of a duplicated topic.
const canonicalPath = `/writing/${canonical.id}`;

// If the long version lives on the academic site, that is the canonical home of
// this piece and this page is explicitly the extract.
const full = fullVersionOf(post);
const here = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  canonicalUrl={full?.url}
  canonicalPath={isCanonical ? undefined : canonicalPath}
>
  <article class:list={['prose', isNewsletter && 'prose-mirror']}>
    <p class="typed">{label(post)}</p>
    <h1>{post.data.title}</h1>
    <p class="byline">
      {fmt(post.data.date)}
      {
        post.data.linkedinUrl && (
          <>
            {' · '}
            <a href={post.data.linkedinUrl} rel="noopener noreferrer" target="_blank">
              View on LinkedIn
            </a>
          </>
        )
      }
    </p>

    {
      /* This URL is the shorter form of a topic that exists elsewhere in full. */
      !isCanonical && (
        <aside class="crosslink crosslink-notice">
          <p class="field-key">Fuller version</p>
          <p>
            This is the short {inline(post)} version. The complete piece is the{' '}
            <a href={canonicalPath}>{inline(canonical)} edition</a> — longer, and the one to
            read.
          </p>
        </aside>
      )
    }

    {
      full && (
        <aside class="crosslink crosslink-notice">
          <p class="field-key">Extract</p>
          <p>
            This is the short version — {here.toLocaleString('en-GB')} words. The full essay is{' '}
            {full.words.toLocaleString('en-GB')} words with its full structure, on the academic
            site: <a href={full.url} rel="noopener" target="_blank">read it there ↗</a>
          </p>
        </aside>
      )
    }

    <Content />

    {
      full && (
        <aside class="crosslink">
          <p class="field-key">Continue</p>
          <p>
            That was the extract. The complete essay —{' '}
            {full.words.toLocaleString('en-GB')} words — is at{' '}
            <a href={full.url} rel="noopener" target="_blank">academic.danialamin.com ↗</a>
          </p>
        </aside>
      )
    }

    {
      /* The canonical page points across to the other form(s). */
      isCanonical && alternates.length > 0 && (
        <aside class="crosslink">
          <p class="field-key">Also published as</p>
          <ul >
            {alternates.map((alt) => (
              <li>
                <a href={`/writing/${alt.id}`}>
                  {label(alt)} edition ({fmt(alt.data.date)})
                </a>
                {alt.data.linkedinUrl && (
                  <>
                    {' · '}
                    <a href={alt.data.linkedinUrl} rel="noopener noreferrer" target="_blank">
                      on LinkedIn ↗
                    </a>
                  </>
                )}
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <p style="margin-top:2rem">
      <a class="jump" href="/writing">
        ← All writing
      </a>
    </p>
  </article>
</Base>
