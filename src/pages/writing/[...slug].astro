---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getWriting, fullVersionOf, type Post } from '../../lib/writing';
import { ACADEMIC_IS_LOCAL, ACADEMIC_IS_CANONICAL } from '../../lib/origins';
import site from '../../data/site.json';

export async function getStaticPaths() {
  // Every post keeps its own URL, including alternates, so nothing 404s and
  // links already shared on LinkedIn keep resolving.
  const { all } = await getWriting();
  return all.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { canonicalFor, alternatesFor } = await getWriting();

const canonical = canonicalFor.get(post.id) ?? post;
const isCanonical = canonical.id === post.id;
const alternates = alternatesFor.get(post.id) ?? [];

const { Content, headings } = await render(post);
const isNewsletter = post.data.source === 'newsletter';
/** masthead label, e.g. "AI Pulse & Data Waves" */
const label = (p: Post) => (p.data.source === 'newsletter' ? site.newsletterName : 'Essay');
/** lowercase form that reads correctly inside a sentence */
const inline = (p: Post) => (p.data.source === 'newsletter' ? 'newsletter' : 'essay');

function fmt(d: Date) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Point search engines at the fuller version of a duplicated topic.
const canonicalPath = `/writing/${canonical.id}`;

// If the long version lives on the academic site, that is the canonical home of
// this piece and this page is explicitly the extract — but only while the sister
// site is at its permanent address. See ACADEMIC_IS_CANONICAL.
const full = fullVersionOf(post);
const here = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;

/**
 * The extracts carry no headings, so the rail holds what is actually useful on
 * this page instead: the length, the link to the full version, and the other
 * form of the same topic. That is what lets the page use the full shell width
 * rather than leaving a 40% margin beside a narrow column.
 */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  canonicalUrl={ACADEMIC_IS_CANONICAL ? full?.url : undefined}
  canonicalPath={isCanonical ? undefined : canonicalPath}
>
  <article class="piece">
    <header class="piece-head">
      <p class="typed">{label(post)}</p>
      <h1 class="cover-name piece-title">{post.data.title}</h1>
      {post.data.excerpt && <p class="cover-line piece-deck">{post.data.excerpt}</p>}
    </header>

    <div class="piece-grid">
      <aside class="piece-rail">
        <dl class="piece-facts">
          <div>
            <dt>Published</dt>
            <dd>{fmt(post.data.date)}</dd>
          </div>
          <div>
            <dt>Form</dt>
            <dd>{label(post)}</dd>
          </div>
          <div>
            <dt>This page</dt>
            <dd>{here.toLocaleString('en-GB')} words</dd>
          </div>
          {
            full && (
              <div>
                <dt>Full essay</dt>
                <dd>{full.words.toLocaleString('en-GB')} words</dd>
              </div>
            )
          }
        </dl>

        {
          full && (
            <p class="piece-cta">
              <a class="btn" href={full.url} rel="noopener" target="_blank">Read it in full ↗</a>
              {ACADEMIC_IS_LOCAL && <span class="local-note">local: {full.url}</span>}
            </p>
          )
        }

        {
          toc.length > 0 && (
            <nav class="piece-toc" aria-label="Contents">
              <p class="piece-rail-h">Contents</p>
              <ol>
                {toc.map((h) => (
                  <li class:list={[h.depth === 3 && 'is-sub']}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {
          !isCanonical && (
            <p class="piece-rail-note">
              This is the short {inline(post)}. The fuller form is the{' '}
              <a href={canonicalPath}>{inline(canonical)} edition</a>.
            </p>
          )
        }

        {
          isCanonical && alternates.length > 0 && (
            <p class="piece-rail-note">
              Also published as{' '}
              {alternates.map((alt, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/writing/${alt.id}`}>the {inline(alt)} edition</a>
                </>
              ))}
              .
            </p>
          )
        }

        {
          post.data.linkedinUrl && (
            <p class="piece-rail-note">
              <a href={post.data.linkedinUrl} rel="noopener noreferrer" target="_blank">
                View on LinkedIn ↗
              </a>
            </p>
          )
        }

        {
          post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.slice(0, 8).map((t) => <li class="tag">{t}</li>)}
            </ul>
          )
        }

        <p class="piece-rail-note"><a class="jump" href="/writing">← All writing</a></p>
      </aside>

      <div class:list={['prose', isNewsletter && 'prose-mirror']}>
        <Content />

        {
          full && (
            <aside class="crosslink">
              <p class="field-key">Continue</p>
              <p>
                That was the extract — {here.toLocaleString('en-GB')} of{' '}
                {full.words.toLocaleString('en-GB')} words. The complete essay is at{' '}
                {/* Named rather than spelled out. It used to print the domain,
                    which contradicted the href as soon as the origin moved — and
                    the origin is currently a railway.app hostname, which has no
                    business in body copy. */}
                <a href={full.url} rel="noopener" target="_blank">the academic site ↗</a>
              </p>
            </aside>
          )
        }
      </div>
    </div>
  </article>
</Base>
