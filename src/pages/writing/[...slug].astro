---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isNewsletter = post.data.source === 'newsletter';

function fmt(d: Date) {
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={post.data.title} description={post.data.excerpt}>
  <article class:list={['prose', isNewsletter && 'prose-mirror']}>
    <p class="mono-label">{isNewsletter ? site.newsletterName : 'Essay'}</p>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {fmt(post.data.date)}
      {
        post.data.linkedinUrl && (
          <>
            {' · '}
            <a href={post.data.linkedinUrl} rel="noopener noreferrer" target="_blank">
              View on LinkedIn
            </a>
          </>
        )
      }
    </p>

    <Content />

    <p class="after-list">
      <a class="text-link" href="/writing">
        <span class="arrow" aria-hidden="true">←</span> All writing
      </a>
    </p>
  </article>
</Base>
