---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { getWriting } from '../../lib/writing';
import site from '../../data/site.json';

const { items: posts, all, alternatesFor } = await getWriting();
const essays = all.filter((p) => p.data.source === 'essay').length;
const newsletters = all.filter((p) => p.data.source === 'newsletter').length;
const merged = [...alternatesFor.keys()].length;
---

<Base title="Writing" description={`Essays and full mirrors of ${site.newsletterName}.`}>
  <header class="hero hero-compact">
    <div>
      <p class="hero-kicker"><span>Writing</span></p>
      <h1 class="hero-display hero-display-sm">
        <span class="line-mask"><span>Pulse</span></span>
        <span class="line-mask" style="--reveal-delay:110ms"><span>&amp; essays</span></span>
      </h1>
      <p class="hero-tagline" data-reveal style="--reveal-delay:340ms">
        On-site mirrors of <a href={site.newsletterUrl} rel="noopener noreferrer" target="_blank"
          >{site.newsletterName}</a
        >, plus longer essays. Nothing here is gated.
      </p>
    </div>

    <aside class="readout" data-reveal style="--reveal-delay:480ms" aria-label="At a glance">
      <div class="readout-bar"><span>Archive</span></div>
      <div class="readout-row">
        <span class="readout-key">Essays</span>
        <span class="readout-val">{essays}</span>
      </div>
      <div class="readout-row">
        <span class="readout-key">Newsletters</span>
        <span class="readout-val">{newsletters}</span>
      </div>
      <div class="readout-row">
        <span class="readout-key">Total</span>
        <span class="readout-val">{posts.length}</span>
      </div>
    </aside>
  </header>

  <div class="section">
    <div class="filter-bar" role="group" aria-label="Filter writing">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="newsletter" aria-pressed="false">Newsletter</button>
      <button type="button" data-filter="essay" aria-pressed="false">Essays</button>
    </div>

    <p class="filter-count" id="filter-count" aria-live="polite">
      Showing all {posts.length}{merged > 0 ? ` · ${merged} published in both forms` : ''}
    </p>

    <WritingList posts={posts} alternatesFor={alternatesFor} />
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-bar button');
  const items = document.querySelectorAll<HTMLElement>('#writing-list li');
  const count = document.getElementById('filter-count');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      let shown = 0;
      items.forEach((li) => {
        // a topic published in both forms belongs to both filters
        const show =
          filter === 'all' || li.dataset.source === filter || li.dataset.both === 'true';
        li.hidden = !show;
        if (show) shown += 1;
      });

      if (count) {
        count.textContent =
          filter === 'all' ? `Showing all ${shown}` : `Showing ${shown} · ${filter}`;
      }
    });
  });
</script>
