---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Ink from '../../components/Ink.astro';
import { publications, tally, cite } from '../../lib/publications';
import news from '../../data/news.json';
import site from '../../data/site.json';
import { academicHome } from '../../lib/origins';
import { keepWordsWhole } from '../../lib/type';
import Plate from '../../components/Plate.astro';
---

<Base title="Research" description="Research on AI-generated personas, representation, and HCI. Full publication details are on my academic site.">
  <header class="cover">
    <p class="cover-issue">
      <span>Section — Research</span>
      <span>University of Vaasa</span>
      <span>PersonaTeam</span>
      <span>{tally.landed} published · {tally.inReview} in review</span>
    </p>
    <h1 class="cover-name" style="font-size:var(--t-4)">
      <Ink text="Personas" y={4} fromY={20} />
      <Ink text="& fairness" x={5} y={5} fromX={20} fromY={24} />
    </h1>
    <p class="cover-line" data-set style="--set-delay:220ms">
      I study how AI-generated personas represent people and how to evaluate those
      representations.
    </p>
    <div class="cover-actions" data-set style="--set-delay:300ms">
      <a class="btn" href={academicHome} rel="noopener noreferrer" target="_blank">Academic site</a>
      <a class="btn btn-out" href={site.socials.scholar} rel="noopener noreferrer" target="_blank">Scholar</a>
      <a class="btn btn-out" href={site.socials.orcid} rel="noopener noreferrer" target="_blank">ORCID</a>
    </div>
  </header>

  <Section num="1" title="Publications" note="Publication details and BibTeX entries are on my academic site." id="publications">
    <ul class="listing" data-run>
      {publications.map((p, i) => (
        <li style={`--i:${i}`}>
          <div class="entry" data-lift>
            <span class="entry-num">
              {String(i + 1).padStart(2, '0')}
              <Plate seed={p.title} size={32} class="entry-plate" />
            </span>
            <span class="entry-title" style="font-family:var(--body);font-weight:700;font-size:1rem;text-transform:none">
              {keepWordsWhole(p.title)}
            </span>
            <span class="entry-meta">{cite(p)}</span>
            <p class="entry-blurb">{p.status}{p.doi ? ` · doi:${p.doi}` : ''}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section num="2" title="News" id="news">
    <ul class="listing" data-run>
      {news.map((n, i) => (
        <li style={`--i:${i}`}>
          <div class="entry" data-lift>
            <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="entry-title" style="font-family:var(--body);font-weight:600;font-size:0.98rem;text-transform:none">
              {keepWordsWhole(n.text)}
            </span>
            <span class="entry-meta">{n.date}</span>
          </div>
        </li>
      ))}
    </ul>
  </Section>
</Base>
