---
import Base from '../../layouts/Base.astro';
import publications from '../../data/publications.json';
import news from '../../data/news.json';
import site from '../../data/site.json';
---

<Base
  title="Research"
  description="GenAI personas, fairness, and HCI — with the full record on the academic site"
  page="research"
>
  <header class="page-intro page-intro-research">
    <p class="page-eyebrow">Research</p>
    <h1 class="page-h1 research-h1">Personas · fairness · HCI</h1>
    <p class="page-deck">
      Doctoral candidate, University of Vaasa (PersonaTeam). This page is a teaser — the full record lives on the academic site.
    </p>
    <div class="research-actions">
      <a class="btn" href={site.academicUrl} rel="noopener noreferrer" target="_blank">academic.danialamin.com</a>
      <a class="btn btn-ghost" href={site.socials.scholar} rel="noopener noreferrer" target="_blank">Scholar</a>
      <a class="btn btn-ghost" href={site.socials.orcid} rel="noopener noreferrer" target="_blank">ORCID</a>
    </div>
  </header>

  <section class="section research-pubs">
    <p class="section-label">Selected publications</p>
    <ol class="bib-list">
      {
        publications.map((p, i) => (
          <li class="bib-item">
            <span class="bib-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="bib-title">{p.title}</p>
              <p class="bib-meta">
                {p.venue} · {p.year} · {p.status}
                {p.doi ? ` · doi:${p.doi}` : ''}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section research-news">
    <p class="section-label">News</p>
    <ul class="news-list">
      {
        news.map((n) => (
          <li>
            <time>{n.date}</time>
            <span>{n.text}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
