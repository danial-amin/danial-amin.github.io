---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import systems from '../../data/systems.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return systems.map((s) => ({ params: { id: s.id }, props: { system: s } }));
}

const { system } = Astro.props;
const i = systems.findIndex((s) => s.id === system.id);
const prev = systems[i - 1];
const next = systems[i + 1];

const short = (s: { name: string }) => s.name.split('—')[0].trim();
const name = short(system);
---

<Base title={name} description={system.blurb}>
  <header class="hero hero-compact">
    <div>
      <p class="detail-kicker">
        <a href="/work">Work</a>
        <span aria-hidden="true">/</span>
        <span>System {String(i + 1).padStart(2, '0')}</span>
      </p>

      <h1 class="hero-display hero-display-sm">
        <span class="line-mask"><span>{name}</span></span>
      </h1>

      <p class="hero-tagline" data-reveal style="--reveal-delay:280ms">{system.blurb}</p>

      <div class="hero-actions" data-reveal style="--reveal-delay:400ms">
        <a class="btn" href={system.url} rel="noopener noreferrer" target="_blank">
          <span>Open {name} ↗</span>
        </a>
        <a class="btn btn-ghost" href="/work"><span>All systems</span></a>
      </div>
    </div>

    <aside class="readout" data-reveal style="--reveal-delay:520ms" aria-label="System status">
      <div class="readout-bar">
        <span>Status</span>
        <span class="dot" aria-hidden="true"></span>
      </div>
      <div class="readout-row">
        <span class="readout-key">State</span>
        <span class="readout-val">{system.status}</span>
      </div>
      <div class="readout-row">
        <span class="readout-key">Host</span>
        <span class="readout-val">{new URL(system.url).hostname}</span>
      </div>
      <div class="readout-row">
        <span class="readout-key">Built by</span>
        <span class="readout-val">{site.name}</span>
      </div>
    </aside>
  </header>

  <Section num="01" title="Why it exists" note="The annoyance that justified building it.">
    <p class="detail-lead" data-reveal>{system.why}</p>
  </Section>

  <Section num="02" title="What shipped" note="What is actually running today, not a roadmap.">
    <p class="detail-text" data-reveal>{system.built}</p>
    <p class="after-list" data-reveal>
      <a class="text-link" href={system.url} rel="noopener noreferrer" target="_blank">
        Try it yourself <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </p>
  </Section>

  <nav class="pager" aria-label="Other systems">
    {
      prev ? (
        <a href={`/systems/${prev.id}`}>
          <span class="pager-dir">← Previous</span>
          <span class="pager-name">{short(prev)}</span>
        </a>
      ) : (
        <a href="/work">
          <span class="pager-dir">← Back</span>
          <span class="pager-name">All work</span>
        </a>
      )
    }
    {
      next ? (
        <a class="pager-next" href={`/systems/${next.id}`}>
          <span class="pager-dir">Next →</span>
          <span class="pager-name">{short(next)}</span>
        </a>
      ) : (
        <a class="pager-next" href="/writing">
          <span class="pager-dir">Next →</span>
          <span class="pager-name">Writing</span>
        </a>
      )
    }
  </nav>
</Base>
